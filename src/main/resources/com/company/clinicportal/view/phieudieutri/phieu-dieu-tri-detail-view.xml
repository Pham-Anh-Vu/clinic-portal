<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://phieuDieuTriDetailView.title"
      focusComponent="form">
    <data>
        <instance id="phieuDieuTriDc"
                  class="com.company.clinicportal.entity.PhieuDieuTri">
            <fetchPlan extends="_base">
                <property name="id"/>
            </fetchPlan>
            <loader id="phieuDieuTriDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="phieuDieuTriDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <dateTimePicker id="createdAtField" property="createdAt"/>
            <textField id="createdByIdField" property="createdById"/>
            <textField id="ghiChuField" property="ghiChu"/>
            <textField id="idBenhNhanField" property="idBenhNhan"/>
            <dateTimePicker id="ngayKhamField" property="ngayKham"/>
            <datePicker id="thoiGianTaiKhamField" property="thoiGianTaiKham"/>
            <textField id="trangThaiField" property="trangThai"/>
            <dateTimePicker id="updatedAtField" property="updatedAt"/>
            <textField id="updatedByIdField" property="updatedById"/>
        </formLayout>
        <hbox id="lienThongBtnBox" spacing="true" padding="true" alignItems="CENTER">
            <button id="keDonThuocButton" text="Kê đơn thuốc" icon="vaadin:pill"/>
        </hbox>
        <hbox id="detailActions" justifyContent="END" alignItems="END" alignSelf="END">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
