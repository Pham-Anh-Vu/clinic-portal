<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://nhanSuListView.title"
      focusComponent="nhanSusDataGrid">
    <data>
        <collection id="nhanSusDc"
                    class="com.company.clinicportal.entity.NhanSu">
            <fetchPlan extends="_base">
                <property name="id"/>
            </fetchPlan>
            <loader id="nhanSusDl" readOnly="true">
                <query>
                    <![CDATA[select e from NhanSu e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="nhanSusDl" opened="false">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel" justifyContent="END">
            <button id="createButton" action="nhanSusDataGrid.createAction"/>
            <button id="refreshButton" action="nhanSusDataGrid.refreshAction"/>
        </hbox>
        <dataGrid id="nhanSusDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="nhanSusDc"
                  columnReorderingAllowed="true">
            <emptyStateComponent>
                <vbox width="100%" height="100%" alignItems="CENTER" justifyContent="CENTER">
                    <icon icon="vaadin:file-o" size="48px" color="var(--lumo-tertiary-text-color)"/>
                    <h2 text="Chưa có dữ liệu"/>
                </vbox>
            </emptyStateComponent>
            <actions>
                <action id="createAction" type="list_create" text="Thêm nhân sự">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                    </properties>
                </action>
                <action id="editAction" type="list_edit" text="Sửa">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                    </properties>
                </action>
                <action id="removeAction" type="list_remove" text="Xóa">
                </action>
                <action id="readAction" type="list_read" text="Xem">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                    </properties>
                </action>
                <action id="refreshAction" type="list_refresh"/>
            </actions>
            <columns resizable="true">
                <column property="maNhanSu"/>
                <column property="hoTen" header="Họ và tên nhân sự"/>
                <column property="dienThoai"/>
                <column property="gioiTinh"/>
                <column property="ngayVaoLam"/>
                <column property="chucVu"/>
                <column property="hinhThucLamVic"/>
            </columns>
        </dataGrid>
        <simplePagination id="pagination" dataLoader="nhanSusDl" alignSelf="END"/>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
