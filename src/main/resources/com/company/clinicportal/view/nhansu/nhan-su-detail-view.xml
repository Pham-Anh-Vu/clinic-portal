<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://nhanSuDetailView.title"
      focusComponent="form">
    <data>
        <instance id="nhanSuDc"
                  class="com.company.clinicportal.entity.NhanSu">
            <fetchPlan extends="_base">
                <property name="id"/>
            </fetchPlan>
            <loader id="nhanSuDl"/>
        </instance>
        <collection id="tinhKpisDc" class="com.company.clinicportal.entity.TinhKpi">
            <loader id="tinhKpisDl" readOnly="true">
                <query>
                    <![CDATA[select e from TinhKpi e where e.idNhanSu = :idNhanSu]]>
                </query>
            </loader>
            <fetchPlan extends="_base"/>
        </collection>
        <collection id="chiTietDichVusDc" class="com.company.clinicportal.entity.ChiTietDichVu">
            <loader id="chiTietDichVusDl" readOnly="true">
                <query>
                    <![CDATA[select e from ChiTietDichVu e]]>
                </query>
            </loader>
            <fetchPlan extends="_base"/>
        </collection>
        <collection id="buoiDieuTrisDc" class="com.company.clinicportal.entity.BuoiDieuTri">
            <loader id="buoiDieuTrisDl" readOnly="true">
                <query>
                    <![CDATA[select e from BuoiDieuTri e where e.idNhanSuStaging = :idNhanSuStaging ]]>
                </query>
            </loader>
            <fetchPlan extends="_base"/>
        </collection>

    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="nhanSuDc">

            <textField id="chucVuField" property="chucVu"/>
            <dateTimePicker id="createdAtField" property="createdAt"/>
            <textField id="createdByIdField" property="createdById"/>
            <textField id="diaChiField" property="diaChi"/>
            <textField id="dienThoaiField" property="dienThoai"/>
            <textField id="gioiTinhField" property="gioiTinh"/>
            <textField id="hinhThucLamVicField" property="hinhThucLamVic"/>
            <textField id="hoTenField" property="hoTen"/>
            <textField id="luongCoBanField" property="luongCoBan"/>
            <textField id="maNhanSuField" property="maNhanSu"/>
            <datePicker id="ngaySinhField" property="ngaySinh"/>
            <datePicker id="ngayVaoLamField" property="ngayVaoLam"/>

            <dataGrid id="buoiDieuTrisDataGrid" dataContainer="buoiDieuTrisDc" minWidth="100px" width="100%" colspan="2">
                <actions>
                    <action id="create" type="list_create"/>
                    <action id="edit" type="list_edit"/>
                    <action id="remove" type="list_remove"/>
                </actions>
                <columns>
                    <column property="ca"/>
                    <column property="createdAt"/>
                    <column property="createdById"/>
                    <column property="fS6gkc3y0vfj"/>
                    <column property="gioBatDau"/>
                    <column property="gioBatDauStaging"/>
                    <column property="gioKetThuc"/>
                    <column property="idBenhNhan"/>
                    <column property="idNgayDieuTri"/>
                    <column property="idNhanSu2"/>
                    <column property="idNhanSu2Staging"/>
                    <column property="ngayThucHien"/>
                    <column property="ngayThucHienStaging"/>
                    <column property="trangThai"/>
                    <column property="updatedAt"/>
                    <column property="updatedById"/>
                </columns>
            </dataGrid>
            <dataGrid id="tinhKpisDataGrid" dataContainer="tinhKpisDc" minWidth="100px" width="100%" colspan="2">
                <actions>
                    <action id="create" type="list_create"/>
                    <action id="edit" type="list_edit"/>
                    <action id="remove" type="list_remove"/>
                </actions>
                <columns>
                    <column property="createdAt"/>
                    <column property="createdById"/>
                    <column property="idLuongThang"/>
                    <column property="kpiSang"/>
                    <column property="kpiToi"/>
                    <column property="kpiTong"/>
                    <column property="thang"/>
                    <column property="thanhTien"/>
                    <column property="updatedAt"/>
                    <column property="updatedById"/>
                </columns>
            </dataGrid>
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
