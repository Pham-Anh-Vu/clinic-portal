<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://nhanSuDetailView.title"
      focusComponent="form"
>
    <data>
        <instance id="nhanSuDc"
                  class="com.company.clinicportal.entity.NhanSu">
            <fetchPlan extends="_base">
                <property name="id"/>
            </fetchPlan>
            <loader id="nhanSuDl"/>
        </instance>
        <collection id="tinhKpisDc" class="com.company.clinicportal.entity.TinhKpi">
            <loader id="tinhKpisDl" readOnly="true">
                <query>
                    <![CDATA[select e from TinhKpi e where e.idNhanSu = :idNhanSu]]>
                </query>
            </loader>
            <fetchPlan extends="_base"/>
        </collection>
        <collection id="tinhKpiChiTietsDc" class="com.company.clinicportal.entity.TinhKpiChiTiet">
            <loader id="tinhKpiChiTietsDl" readOnly="true">
                <query>
                    <![CDATA[select e from TinhKpiChiTiet e
                              where e.idNhanSu = :idNhanSu
                              order by e.ngayThucHien desc, e.id desc]]>
                </query>
            </loader>
            <fetchPlan>
                <property name="caThucHien"/>
                <property name="ngayThucHien"/>
                <property name="trongSoKpi"/>
                <property name="thanhTien"/>
                <property name="idChiTietDichVu" fetchPlan="_base">
                    <property name="idDichVu" fetchPlan="_base">
                        <property name="tenDichVu"/>
                    </property>
                </property>
                <property name="idChiTietDieuTri" fetchPlan="_base">
                    <property name="tenPhieuDieuTri"/>
                    <property name="idBenhNhan" fetchPlan="_base">
                        <property name="hoVaTen"/>
                    </property>
                </property>
            </fetchPlan>
        </collection>

    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="nhanSuDc">

            <vbox width="100%" alignItems="START" padding="false"
                  spacing="false" classNames="tab-5-grid" colspan="2">
                <vbox spacing="false" padding="false" classNames="header-grid-auto-pay"
                      width="100%">
                    <hbox classNames="buttons-panel" width="100%">
                        <div width="100%" classNames="all-control-auto-pay">
                            <div classNames="title-grid">
                                <span text="THÔNG TIN CHUNG"/>
                            </div>
                        </div>
                    </hbox>
                </vbox>

                <vbox padding="false" classNames="grid-data">
                    <formLayout css="border: 1px #BFBFBF solid; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; padding: 20px" >
                        <responsiveSteps>
                            <responsiveStep minWidth="0" columns="4"/>
                        </responsiveSteps>
                        <textField label="Thông tin nhân sự" id="hoTenField" property="hoTen" required="true"/>
                        <datePicker id="ngaySinhField" property="ngaySinh"/>
                        <select id="gioiTinhField" property="gioiTinh" required="true"/>
                        <textField id="dienThoaiField" property="dienThoai"/>
                        <datePicker id="ngayVaoLamField" property="ngayVaoLam"/>
                        <select id="chucVuField" property="chucVu" required="true"/>
                        <textField id="luongCoBanField" property="luongCoBan"/>
                        <textField id="diaChiField" property="diaChi"/>
                        <textField id="maNhanSuField" property="maNhanSu"/>
                    </formLayout>
                </vbox>
            </vbox>

            <vbox id="kpiMonth" width="100%" alignItems="START" padding="false"
                  spacing="false" classNames="tab-5-grid" colspan="2" visible="false">
                <vbox spacing="false" padding="false" classNames="header-grid-auto-pay"
                      width="100%">
                    <hbox classNames="buttons-panel" width="100%">
                        <div width="100%" classNames="all-control-auto-pay">
                            <div classNames="title-grid">
                                <span text="CHI TIẾT KPI"/>
                            </div>
                        </div>
                    </hbox>
                </vbox>

                <vbox padding="false" classNames="grid-data">
                    <formLayout css="border: 1px #BFBFBF solid; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; padding: 20px" >
                        <responsiveSteps>
                            <responsiveStep minWidth="0" columns="2"/>
                        </responsiveSteps>
                        <dataGrid id="tinhKpiChiTietsDataGrid" dataContainer="tinhKpiChiTietsDc" minWidth="100px" width="100%" colspan="2" columnReorderingAllowed="true">
                            <emptyStateComponent>
                                <vbox width="100%" height="100%" alignItems="CENTER" justifyContent="CENTER">
                                    <icon icon="vaadin:file-o" size="48px" color="var(--lumo-tertiary-text-color)"/>
                                    <h2 text="Chưa có dữ liệu"/>
                                </vbox>
                            </emptyStateComponent>
                            <columns resizable="true">
                                <column property="idChiTietDieuTri.idBenhNhan.hoVaTen" header="Họ và tên bệnh nhân"/>
                                <column property="idChiTietDichVu.idDichVu.tenDichVu"/>
                                <column property="idChiTietDieuTri.tenPhieuDieuTri"/>
                                <column property="ngayThucHien"/>
                                <column property="caThucHien"/>
                                <column property="trongSoKpi"/>
                                <column property="thanhTien"/>
                            </columns>
                        </dataGrid>
                    </formLayout>
                </vbox>
            </vbox>

            <vbox id="kpiDetail" width="100%" alignItems="START" padding="false"
                  spacing="false" classNames="tab-5-grid" colspan="2" visible="false">
                <vbox spacing="false" padding="false" classNames="header-grid-auto-pay"
                      width="100%">
                    <hbox classNames="buttons-panel" width="100%">
                        <div width="100%" classNames="all-control-auto-pay">
                            <div classNames="title-grid">
                                <span text="KPI theo tháng"/>
                            </div>
                        </div>
                    </hbox>
                </vbox>

                <vbox padding="false" classNames="grid-data">
                    <formLayout css="border: 1px #BFBFBF solid; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; padding: 20px" >
                        <responsiveSteps>
                            <responsiveStep minWidth="0" columns="2"/>
                        </responsiveSteps>
                        <dataGrid id="tinhKpisDataGrid" dataContainer="tinhKpisDc" minWidth="100px" width="100%" colspan="2">
                            <emptyStateComponent>
                                <vbox width="100%" height="100%" alignItems="CENTER" justifyContent="CENTER">
                                    <icon icon="vaadin:file-o" size="48px" color="var(--lumo-tertiary-text-color)"/>
                                    <h2 text="Chưa có dữ liệu"/>
                                </vbox>
                            </emptyStateComponent>
                            <actions>
                                <action id="create" type="list_create"/>
                                <action id="edit" type="list_edit"/>
                                <action id="remove" type="list_remove"/>
                            </actions>
                            <columns resizable="true">
                                <column property="thang"/>
                                <column property="kpiSang"/>
                                <column property="kpiToi"/>
                                <column property="kpiTong"/>
                                <column property="thanhTien"/>
                            </columns>
                        </dataGrid>
                    </formLayout>
                </vbox>
            </vbox>


            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
        </formLayout>
        <hbox id="detailActions" justifyContent="END" alignItems="END" alignSelf="END">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
