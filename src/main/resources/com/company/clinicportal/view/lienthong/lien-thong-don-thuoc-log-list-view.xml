<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://lienThongDonThuocLogListView.title"
      focusComponent="lienThongDonThuocLogsDataGrid">
    <data readOnly="true">
        <collection id="lienThongDonThuocLogsDc"
                    class="com.company.clinicportal.lienthong.entity.LienThongDonThuocLog">
            <fetchPlan extends="_base"/>
            <loader id="lienThongDonThuocLogsDl" readOnly="true">
                <query>
                    <![CDATA[select e from ltcs_LienThongDonThuocLog e order by e.createdAt desc]]>
                </query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="lienThongDonThuocLogsDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createButton" action="lienThongDonThuocLogsDataGrid.createAction" visible="false"/>
            <button id="editButton" action="lienThongDonThuocLogsDataGrid.editAction" visible="false"/>
            <button id="removeButton" action="lienThongDonThuocLogsDataGrid.removeAction" visible="false"/>
            <simplePagination id="pagination" dataLoader="lienThongDonThuocLogsDl"/>
        </hbox>
        <dataGrid id="lienThongDonThuocLogsDataGrid"
                  width="100%"
                  columnReorderingAllowed="true"
                  minHeight="20em"
                  dataContainer="lienThongDonThuocLogsDc">
            <emptyStateComponent>
                <vbox width="100%" height="100%" alignItems="CENTER" justifyContent="CENTER">
                    <icon icon="vaadin:file-o" size="48px" color="var(--lumo-tertiary-text-color)"/>
                    <h2 text="Chưa có dữ liệu"/>
                </vbox>
            </emptyStateComponent>
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="createdAt"/>
                <column property="api"/>
                <column property="maDonThuoc"/>
                <column property="httpStatus"/>
                <column property="latencyMs"/>
                <column property="outcome"/>
                <column property="retryable"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
