<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://lienThongDonThuocOutboxListView.title"
      focusComponent="lienThongDonThuocOutboxesDataGrid">
    <data readOnly="true">
        <collection id="lienThongDonThuocOutboxesDc"
                    class="com.company.clinicportal.lienthong.entity.LienThongDonThuocOutbox">
            <fetchPlan extends="_base"/>
            <loader id="lienThongDonThuocOutboxesDl" readOnly="true">
                <query>
                    <![CDATA[select e from ltcs_LienThongDonThuocOutbox e order by e.nextAttemptAt desc]]>
                </query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout spacing="true" padding="true">
        <hbox id="filterBox" spacing="true" alignItems="END">
            <comboBox id="statusFilter"
                      label="Trạng thái"
                      placeholder="ALL"/>
        </hbox>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="retryBtn" text="Retry job" icon="vaadin:refresh"/>
            <button id="bulkRetryBtn" text="Retry nhiều job" icon="vaadin:recycle"/>
            <simplePagination id="pagination" dataLoader="lienThongDonThuocOutboxesDl"/>
        </hbox>
        <dataGrid id="lienThongDonThuocOutboxesDataGrid"
                  width="100%"
                  columnReorderingAllowed="true"
                  multiSelect="true"
                  minHeight="20em"
                  dataContainer="lienThongDonThuocOutboxesDc">
            <emptyStateComponent>
                <vbox width="100%" height="100%" alignItems="CENTER" justifyContent="CENTER">
                    <icon icon="vaadin:inbox" size="48px" color="var(--lumo-tertiary-text-color)"/>
                    <h2 text="Không có job outbox nào"/>
                </vbox>
            </emptyStateComponent>
            <columns resizable="true">
                <column property="maDonThuoc"/>
                <column property="api"/>
                <column property="status"/>
                <column property="attempt"/>
                <column property="maxAttempt"/>
                <column property="nextAttemptAt"/>
                <column property="updatedAt"/>
                <column property="lastError"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>