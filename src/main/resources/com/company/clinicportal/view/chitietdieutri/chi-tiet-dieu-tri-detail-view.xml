            <vbox width="100%" alignItems="START" padding="false"
                  spacing="false" classNames="tab-5-grid">
                <vbox spacing="false" padding="false" classNames="header-grid-auto-pay"
                      width="100%">
                    <hbox classNames="buttons-panel" width="100%">
                        <div width="100%" classNames="all-control-auto-pay">
                            <div classNames="title-grid">
                                <span text="THÔNG TIN THANH TOÁN"/>
                            </div>
                        </div>
                    </hbox>
                </vbox>
                <vbox padding="false" classNames="grid-data">
                    <formLayout dataContainer="chiTietDieuTriDc"
                            css="border: 1px #BFBFBF solid; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; padding: 20px">
                        <responsiveSteps>
                            <responsiveStep minWidth="0" columns="6"/>
                        </responsiveSteps>
                        <textField id="tongTienField" property="tongTien" readOnly="true"/>
                        <textField id="khuyenMaiField" property="khuyenMai" placeholder="VD: 10,5 hoặc 10.5"/>
                        <textField id="tongTienSauKhuyenMaiField" property="tongTienSauKhuyenMai" readOnly="true"/>
                        <textField id="daThanhToanField" property="daThanhToan" readOnly="true"/>
                        <textField id="phaiDongField" property="phaiDong" readOnly="true"/>
                        <datePicker id="ngayThanhToanField" property="ngayThanhToan" readOnly="true"/>
                    </formLayout>
                </vbox>
            </vbox>

            <vbox width="100%" alignItems="START" padding="false"
                  spacing="false" classNames="tab-5-grid">
                <vbox spacing="false" padding="false" classNames="header-grid-auto-pay"
                      width="100%">
                    <hbox classNames="buttons-panel" width="100%">
                        <div width="100%" classNames="all-control-auto-pay">
                            <div classNames="title-grid">
                                <span text="LỊCH SỬ THANH TOÁN"/>
                            </div>
                            <div classNames="function-flex-end">
                                <button action="lichSuThanhToansDataGrid.create" classNames="action-button"/>
                                <button action="lichSuThanhToansDataGrid.refresh" classNames="action-button"/>
                            </div>
                        </div>
                    </hbox>
                </vbox>
                <vbox padding="false" classNames="grid-data">
                    <formLayout
                            css="border: 1px #BFBFBF solid; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; padding: 20px">
                        <responsiveSteps>
                            <responsiveStep minWidth="0" columns="1"/>
                        </responsiveSteps>
                        <dataGrid id="lichSuThanhToansDataGrid" dataContainer="lichSuThanhToansDc" minWidth="100px"
                                  width="100%">
                            <emptyStateComponent>
                                <vbox width="100%" height="100%" alignItems="CENTER" justifyContent="CENTER">
                                    <icon icon="vaadin:file-o" size="48px" color="var(--lumo-tertiary-text-color)"/>
                                    <h2 text="Chưa có dữ liệu"/>
                                </vbox>
                            </emptyStateComponent>
                            <actions>
                                <action id="create" type="list_create" text="Thanh toán"/>
                                <action id="edit" type="list_edit" text="Chi tiết"/>
                                <action id="remove" type="list_remove" text="Xóa"/>
                                <action id="refresh" type="list_refresh"/>
                            </actions>
                            <columns resizable="true">
                                <column property="thanhToanLuc"/>
                                <column property="daThanhToan"/>
                                <column property="ghiChu"/>
                                <column property="hoTenNguoiNopTien"/>
                                <column property="soDienThoai"/>
                            </columns>
                        </dataGrid>


                    </formLayout>
                </vbox>
            </vbox>
        </formLayout>
        <hbox id="detailActions" justifyContent="END" alignItems="END" alignSelf="END">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
