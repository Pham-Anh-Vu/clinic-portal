                        <textField id="trongSoKPIField" property="trongSoKpi" colspan="2" required="true"/>
                        <textField id="trongSoVatLyTriLieuField" property="trongSoVatLyTriLieu"/>
                        <textField id="trongSoVanDongTriLieuField" property="trongSoVanDongTriLieu"/>
                        <textField id="trongSoKeoNanTriLieuField" property="trongSoKeoNanTriLieu"/>
                        <textField id="trongSoXoaBopTriLieuField" property="trongSoXoaBopTriLieu"/>
