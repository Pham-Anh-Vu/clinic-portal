                                <button action="lichSuThanhToansDataGrid.edit" classNames="action-button"
                                        text="msg:///edit" css="min-width: 80px; height: 28px;"/>
                                <button action="lichSuThanhToansDataGrid.remove" classNames="action-button"
                                        text="msg:///remove" css="min-width: 80px; height: 28px;"/>
                            </div>
                        </div>
                    </hbox>
                </vbox>
                <vbox padding="false" classNames="grid-data">
                    <formLayout
                            css="border: 1px #BFBFBF solid; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; padding: 20px">
                        <responsiveSteps>
                            <responsiveStep minWidth="0" columns="1"/>
