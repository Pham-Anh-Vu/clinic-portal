<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://chiTietDieuTriDetailView.title"
      focusComponent="form">
    <data>
        <instance id="chiTietDieuTriDc"
                  class="com.company.clinicportal.entity.ChiTietDieuTri">
            <fetchPlan extends="_base">
                <property name="id"/>
                <property name="chiTietDichVu" fetchPlan="_base"/>
                <property name="idBenhNhan" fetchPlan="_base">
                </property>
                <property name="idNhanSu" fetchPlan="_base"/>
            </fetchPlan>
            <collection id="chiTietDichVuDc" property="chiTietDichVu"/>
            <loader id="chiTietDieuTriDl"/>
        </instance>
        <collection id="lichSuThanhToansDc" class="com.company.clinicportal.entity.LichSuThanhToan">
            <loader id="lichSuThanhToansDl" readOnly="true">
                <query>
                    <![CDATA[select e from LichSuThanhToan e where e.idPhieuDieuTri = :idPhieuDieuTri]]>
                </query>
            </loader>
            <fetchPlan extends="_base"/>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="chiTietDieuTriDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
            </responsiveSteps>

            <vbox width="100%" alignItems="START" padding="false"
                  spacing="false" classNames="tab-5-grid">
                <vbox spacing="false" padding="false" classNames="header-grid-auto-pay"
                      width="100%">
                    <hbox classNames="buttons-panel" width="100%">
                        <div width="100%" classNames="all-control-auto-pay">
                            <div classNames="title-grid">
                                <span text="THÔNG TIN CHUNG"/>
                            </div>
                        </div>
                    </hbox>
                </vbox>
                <vbox padding="false" classNames="grid-data">
                    <formLayout
                            css="border: 1px #BFBFBF solid; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; padding: 20px">
                        <responsiveSteps>
                            <responsiveStep minWidth="0" columns="4"/>
                        </responsiveSteps>
                        <textField id="idBenhNhanField" property="idBenhNhan.hoVaTen" readOnly="true"/>
                        <textField id="gioiTinhField" property="idBenhNhan.gioiTinh" readOnly="true"/>
                        <textField id="ngaySinhField" property="idBenhNhan.ngaySinh" readOnly="true"/>
                        <textField id="tuoiField" property="idBenhNhan.tuoi" readOnly="true"/>
                        <textField id="dienThoaiField" property="idBenhNhan.dienThoai" readOnly="true"/>
                        <textField id="diaChiField" property="idBenhNhan.diaChi" readOnly="true"/>
                        <textArea id="trieuChungField" height="9.5em" property="trieuChung"/>
                        <textArea id="chuanDoanField" height="9.5em" property="chuanDoan"/>
                        <textField id="idNhanSuField" property="idNhanSu.hoTen" colspan="2" readOnly="true"/>
                    </formLayout>
                </vbox>
            </vbox>

            <vbox width="100%" alignItems="START" padding="false"
                  spacing="false" classNames="tab-5-grid">
                <vbox spacing="false" padding="false" classNames="header-grid-auto-pay"
                      width="100%">
                    <hbox classNames="buttons-panel" width="100%">
                        <div width="100%" classNames="all-control-auto-pay">
                            <div classNames="title-grid">
                                <span text="CHỈ ĐỊNH DỊCH VỤ"/>
                            </div>
                            <div classNames="function-flex-end">
                                <button action="chiTietDichVusDataGrid.create" text="msg:///create"
                                        classNames="action-button create" css="min-width: 80px; height: 28px;"/>
                                <button action="chiTietDichVusDataGrid.edit" text="msg:///edit"
                                        classNames="action-button create" css="min-width: 80px; height: 28px;"/>
                                <button action="chiTietDichVusDataGrid.remove" text="msg:///remove"
                                        classNames="action-button create" css="min-width: 80px; height: 28px;"/>
                            </div>
                        </div>
                    </hbox>
                </vbox>
                <vbox padding="false" classNames="grid-data">
                    <formLayout
                            css="border: 1px #BFBFBF solid; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; padding: 20px">
                        <responsiveSteps>
                            <responsiveStep minWidth="0" columns="1"/>
                        </responsiveSteps>
                        <!--                        <hbox css="width: 100%; justify-content: flex-end; gap: 8px;">-->
                        <!--                           -->
                        <!--                        </hbox>-->
                        <dataGrid id="chiTietDichVusDataGrid"
                                  dataContainer="chiTietDichVuDc"
                                  width="100%">
                            <emptyStateComponent>
                                <vbox width="100%" height="100%" alignItems="CENTER" justifyContent="CENTER">
                                    <icon icon="vaadin:file-o" size="48px" color="var(--lumo-tertiary-text-color)"/>
                                    <h2 text="Chưa có dữ liệu"/>
                                </vbox>
                            </emptyStateComponent>
                            <actions>
                                <action id="create" type="list_create"/>
                                <action id="edit" type="list_edit"/>
                                <action id="remove" type="list_remove"/>
                            </actions>

                            <columns>
                                <column property="idDichVu"/>
                                <column property="idBacSi"/>
                                <column property="khoangCachBuoiDieuTri"/>
                                <column property="soLuong"/>
                                <column property="ngayBatDau"/>
                            </columns>
