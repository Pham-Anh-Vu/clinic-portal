<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="DANH SÁCH PHIẾU CHỈ ĐỊNH"
      focusComponent="chiTietDieuTrisDataGrid">
    <data>
        <collection id="chiTietDieuTrisDc"
                    class="com.company.clinicportal.entity.ChiTietDieuTri">
            <fetchPlan extends="_base">
                <property name="id"/>
                <property name="idBenhNhan" fetchPlan="_base">
                    <property name="hoVaTen"/>
                </property>
                <property name="idNhanSu" fetchPlan="_base">
                    <property name="hoTen"/>
                </property>
            </fetchPlan>
            <loader id="chiTietDieuTrisDl" readOnly="true">
                <query>
                    <![CDATA[
                        select e from ChiTietDieuTri e
                        where (:idBenhNhan is null or e.idBenhNhan.id = :idBenhNhan)
                    ]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="benhNhanBox"
              classNames="benh-nhan-box"
              alignItems="CENTER"
              padding="true"
              spacing="true"
              width="100%">
            <h3 id="benhNhanField"/>

        </hbox>
        <hbox id="buttonsPanel" classNames="buttons-panel" justifyContent="END">
            <button id="createButton" action="chiTietDieuTrisDataGrid.createAction"/>
            <button id="refreshButton" action="chiTietDieuTrisDataGrid.refreshAction"/>
        </hbox>
        <dataGrid id="chiTietDieuTrisDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="chiTietDieuTrisDc"
                  columnReorderingAllowed="true">
            <emptyStateComponent>
                <vbox width="100%" height="100%" alignItems="CENTER" justifyContent="CENTER">
                    <icon icon="vaadin:file-o" size="48px" color="var(--lumo-tertiary-text-color)"/>
                    <h2 text="Chưa có dữ liệu"/>
                </vbox>
            </emptyStateComponent>
            <actions>
                <action id="createAction" type="list_create" text="Thêm phiếu chỉ định">
                    <properties>
                        <property name="viewId" value="PhieuChiDinh.detail"/>
                    </properties>
                </action>
                <action id="editAction" type="list_edit" text="Sửa"/>
                <action id="removeAction" type="list_remove" text="Xóa"/>
                <action id="refreshAction" type="list_refresh"/>
            </actions>
            <columns resizable="true">
                <column property="id"/>
                <column property="idBenhNhan.hoVaTen"/>
                <column property="tenPhieuDieuTri"/>
                <column property="idNhanSu.hoTen"/>
                <column property="tongTien"/>
                <column property="phaiDong"/>
                <column property="daThanhToan"/>
            </columns>
        </dataGrid>
        <simplePagination id="pagination" dataLoader="chiTietDieuTrisDl" alignSelf="END"/>

        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
