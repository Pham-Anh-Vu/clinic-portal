<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://chiTietDieuTriSBADetailView.title">
    <data>
        <instance id="chiTietDieuTriDc"
                  class="com.company.clinicportal.entity.ChiTietDieuTri">
            <fetchPlan extends="_base">
                <property name="idBenhNhan" fetchPlan="_base"/>
                <property name="idNhanSu" fetchPlan="_base"/>
                <property name="tongTien"/>
                <property name="khuyenMai"/>
                <property name="tongTienSauKhuyenMai"/>
                <property name="daThanhToan"/>
                <property name="phaiDong"/>
                <property name="ngayThanhToan"/>
                <property name="trongSoKpi"/>
                <property name="trongSoVatLyTriLieu"/>
                <property name="trongSoVanDongTriLieu"/>
                <property name="trongSoKeoNanTriLieu"/>
                <property name="trongSoXoaBopTriLieu"/>
                <property name="trongSoKhamLuongGia"/>
                <property name="chiTietDichVu" fetchPlan="_base">
                    <property name="idDichVu" fetchPlan="_base"/>
                    <property name="idBacSi" fetchPlan="_base"/>
                </property>
                <property name="fileDinhKem" fetchPlan="_base"/>
                <property name="dsChanDoanIcd" fetchPlan="_base"/>
                <property name="mach"/>
                <property name="nhietDo"/>
                <property name="huyetAp"/>
                <property name="nhipTho"/>
                <property name="canNang"/>
                <property name="chieuCao"/>
            </fetchPlan>
            <collection id="chiTietDichVuDc" property="chiTietDichVu"/>
            <collection id="fileDinhKemDc" property="fileDinhKem"/>
            <loader id="chiTietDieuTriDl"/>
        </instance>
        <collection id="icd10sDc" class="com.company.clinicportal.entity.Icd10">
            <loader id="icd10sDl" readOnly="true">
                <query>
                    <![CDATA[select e from Icd10 e order by e.maIcd]]>
                </query>
            </loader>
            <fetchPlan extends="_base"/>
        </collection>
        <collection id="lichSuThanhToansDc" class="com.company.clinicportal.entity.LichSuThanhToan">
            <loader id="lichSuThanhToansDl" readOnly="true">
                <query>
                    <![CDATA[select e from LichSuThanhToan e
                              where e.idChiTietDieuTri = :idChiTietDieuTri
                              order by e.thanhToanLuc desc, e.id desc]]>
                </query>
            </loader>
            <fetchPlan>
                <property name="thanhToanLuc"/>
                <property name="daThanhToan"/>
                <property name="ghiChu"/>
                <property name="hoTenNguoiNopTien"/>
                <property name="soDienThoai"/>
            </fetchPlan>
        </collection>
        <collection id="toDieuTrisDc" class="com.company.clinicportal.entity.ToDieuTri">
            <loader id="toDieuTrisDl" readOnly="true">
                <query>
                    <![CDATA[select e from ToDieuTri e
                              where e.chiTietDieuTri = :idChiTietDieuTri
                              order by e.tuNgay asc, e.id asc]]>
                </query>
            </loader>
            <fetchPlan>
                <property name="id"/>
                <property name="tuNgay"/>
                <property name="denNgay"/>
                <property name="moTaDienBienBenh"/>
                <property name="ghiChu"/>
                <property name="idNguoiThucHien" fetchPlan="_base"/>
                <property name="idBacSiChiDinh" fetchPlan="_base"/>
                <property name="kyThuatList" fetchPlan="_base">
                    <property name="thoiGianPhut"/>
                    <property name="idDichVu" fetchPlan="_base">
                        <property name="tenDichVu"/>
                    </property>
                </property>
            </fetchPlan>
        </collection>
        <collection id="donThuocsDc" class="com.company.clinicportal.entity.DonThuoc">
            <loader id="donThuocsDl" readOnly="true">
                <query>
                    <![CDATA[select e from DonThuoc e
                              where e.chiTietDieuTri = :idChiTietDieuTri
                              order by e.ngayKe desc, e.createdAt desc]]>
                </query>
            </loader>
            <fetchPlan>
                <property name="id"/>
                <property name="maDonThuoc"/>
                <property name="ngayKe"/>
                <property name="trangThai"/>
                <property name="hinhThucDieuTri"/>
                <property name="tenBacSi"/>
                <property name="loaiDon"/>
                <property name="soLuongThuocTrongDon"/>
                <property name="createdAt"/>
                <property name="hoVaTenBenhNhan"/>
                <property name="maDinhDanhYTe"/>
                <property name="chiTietDieuTri" fetchPlan="_base">
                    <property name="chuanDoan"/>
                    <property name="dsChanDoanIcd" fetchPlan="_base"/>
                </property>
            </fetchPlan>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
