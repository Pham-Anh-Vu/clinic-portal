<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://chiTietDieuTriSBADetailView.title"
>
    <data>
        <instance id="chiTietDieuTriDc"
                  class="com.company.clinicportal.entity.ChiTietDieuTri">
            <fetchPlan extends="_base">
                <property name="idBenhNhan" fetchPlan="_base"/>
                <property name="idNhanSu" fetchPlan="_base"/>
                <property name="chiTietDichVu" fetchPlan="_base"/>
            </fetchPlan>
            <collection id="chiTietDichVuDc" property="chiTietDichVu"/>

            <loader id="chiTietDieuTriDl">
                <query><![CDATA[select e from ChiTietDieuTri e where e.idBenhNhan = :idBenhNhan]]></query>
            </loader>

        </instance>
        <collection id="lichSuThanhToansDc" class="com.company.clinicportal.entity.LichSuThanhToan">
            <loader id="lichSuThanhToansDl" readOnly="true">
                <query>
                    <![CDATA[select e from LichSuThanhToan e
                              where e.idChiTietDieuTri = :idChiTietDieuTri]]>
                </query>
            </loader>
            <fetchPlan extends="_base"/>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <tabSheet width="100%" id="tabSheet" classNames="styled-tabs">

            <tab id="tab1" label="CHI TIẾT PHIẾU ĐIỀU TRỊ">
                <vbox>
                    <vbox width="100%" alignItems="START" padding="false"
                          spacing="false" classNames="tab-5-grid">
                        <vbox spacing="false" padding="false" classNames="header-grid-auto-pay"
                              width="100%">
                            <hbox classNames="buttons-panel" width="100%">
                                <div width="100%" classNames="all-control-auto-pay">
                                    <div classNames="title-grid">
                                        <span text="HÀNH CHÍNH"/>
                                    </div>
                                </div>
                            </hbox>
                        </vbox>
                        <vbox padding="false" classNames="grid-data">
                            <formLayout dataContainer="chiTietDieuTriDc"
                                        css="border: 1px #BFBFBF solid; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; padding: 20px">
                                <responsiveSteps>
                                    <responsiveStep minWidth="0" columns="4"/>
                                </responsiveSteps>
                                <h3 property="tenPhieuDieuTri" colspan="4"/>
                                <textField id="idBenhNhanField" property="idBenhNhan.hoVaTen" readOnly="true" label="Họ tên bệnh nhân"/>
                                <textField id="ngaySinhField" property="idBenhNhan.ngaySinh" readOnly="true"/>
                                <textField id="tuoiField" property="idBenhNhan.tuoi" readOnly="true"/>
                                <textField id="gioiTinhField" property="idBenhNhan.gioiTinh" readOnly="true"/>
                                <textField id="dienThoaiField" property="idBenhNhan.dienThoai" readOnly="true" label="SĐT liên lạc" colspan="2"/>
                                <textArea id="diaChiField" height="9.5em" property="idBenhNhan.diaChi" readOnly="true" colspan="2"/>
                                <textField id="hoTenNguoiThanField" property="idBenhNhan.hoTenNguoiThan" readOnly="true"/>
                                <textField id="sdtNguoiThanField" property="idBenhNhan.sdtNguoiThan" readOnly="true"/>
                                <textField id="quanHeVoiBenhNhanField" property="idBenhNhan.quanHeVoiBenhNhan" readOnly="true"/>
                                <select id="nguonBenhNhanField" property="idBenhNhan.nguonBenhNhan" readOnly="true"/>
                            </formLayout>
                        </vbox>
                    </vbox>

                    <vbox width="100%" alignItems="START" padding="false"
                          spacing="false" classNames="tab-5-grid">
                        <vbox spacing="false" padding="false" classNames="header-grid-auto-pay"
                              width="100%">
                            <hbox classNames="buttons-panel" width="100%">
                                <div width="100%" classNames="all-control-auto-pay">
                                    <div classNames="title-grid">
                                        <span text="LÝ DO VÀO VIỆN"/>
                                    </div>
                                </div>
                            </hbox>
                        </vbox>
                        <vbox padding="false" classNames="grid-data">
                            <formLayout dataContainer="chiTietDieuTriDc"
                                        css="border: 1px #BFBFBF solid; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; padding: 20px">
                                <responsiveSteps>
                                    <responsiveStep minWidth="0" columns="1"/>
                                </responsiveSteps>
                                <textField id="lyDoVaoVienField" property="lyDoVaoVien"/>

                            </formLayout>
                        </vbox>
                    </vbox>

                    <vbox width="100%" alignItems="START" padding="false"
                          spacing="false" classNames="tab-5-grid">
                        <vbox spacing="false" padding="false" classNames="header-grid-auto-pay"
                              width="100%">
                            <hbox classNames="buttons-panel" width="100%">
                                <div width="100%" classNames="all-control-auto-pay">
                                    <div classNames="title-grid">
                                        <span text="HỎI BỆNH"/>
                                    </div>
                                </div>
                            </hbox>
                        </vbox>
                        <vbox padding="false" classNames="grid-data">
                            <formLayout dataContainer="chiTietDieuTriDc"
                                        css="border: 1px #BFBFBF solid; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; padding: 20px">
                                <responsiveSteps>
                                    <responsiveStep minWidth="0" columns="1"/>
                                </responsiveSteps>
                                <textArea id="khamBenhQuaTrinhBenhField" height="9.5em" property="khamBenhQuaTrinhBenh" label="Quá trình bệnh lý"/>
                                <textArea id="khamBenhTienSuBenhField" height="9.5em" property="khamBenhTienSuBenh" label="Tiền sử bệnh"/>
                            </formLayout>
                        </vbox>
                    </vbox>

                    <vbox width="100%" alignItems="START" padding="false"
                          spacing="false" classNames="tab-5-grid">
                        <vbox spacing="false" padding="false" classNames="header-grid-auto-pay"
                              width="100%">
                            <hbox classNames="buttons-panel" width="100%">
                                <div width="100%" classNames="all-control-auto-pay">
                                    <div classNames="title-grid">
                                        <span text="KHÁM BỆNH"/>
                                    </div>
                                </div>
                            </hbox>
                        </vbox>
                        <vbox padding="false" classNames="grid-data">
                            <formLayout dataContainer="chiTietDieuTriDc"
                                        css="border: 1px #BFBFBF solid; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; padding: 20px">
                                <responsiveSteps>
                                    <responsiveStep minWidth="0" columns="2"/>
                                </responsiveSteps>
                                <textField id="idNhanSuField" property="idNhanSu" label="Bác sĩ chỉ định"/>
                                <timePicker id="gioHenMacDinhField" property="gioHenMacDinh"/>
                                <textField id="khamBenhToanThanField" property="khamBenhToanThan" colspan="2"/>
                                <textArea id="ketQuaCanLamSangField" height="9.5em" property="ketQuaCanLamSang" colspan="2" label="Tóm tắt kết quả cận lâm sàng"/>
                                <textArea id="chuanDoanField" height="9.5em" property="chuanDoan" label="Chẩn đoán ban đầu" colspan="2"/>
                                <textField id="daXuLyField" property="daXuLy" colspan="2" label="Đã xử lý (thuốc, chăm sóc)"/>
                            </formLayout>
                        </vbox>
                    </vbox>


                    <vbox width="100%" alignItems="START" padding="false"
                          spacing="false" classNames="tab-5-grid">
                        <vbox spacing="false" padding="false" classNames="header-grid-auto-pay"
                              width="100%">
                            <hbox classNames="buttons-panel" width="100%">
                                <div width="100%" classNames="all-control-auto-pay">
                                    <div classNames="title-grid">
                                        <span text="CHỈ ĐỊNH"/>
                                    </div>
                                    <div classNames="function-flex-end">
                                        <button action="chiTietDichVusDataGrid.create" text="Thêm dịch vụ"
