                                        <button action="chiTietDichVusDataGrid.refresh" classNames="action-button refresh"/>
                                    </div>
                                </div>
                            </hbox>
                        </vbox>
                        <vbox padding="false" classNames="grid-data">
                            <formLayout
                                    css="border: 1px #BFBFBF solid; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; padding: 20px">
                                <responsiveSteps>
                                    <responsiveStep minWidth="0" columns="1"/>
                                </responsiveSteps>
                                <!--                        <hbox css="width: 100%; justify-content: flex-end; gap: 8px;">-->
                                <!--                           -->
                                <!--                        </hbox>-->
                                <dataGrid id="chiTietDichVusDataGrid"
                                          dataContainer="chiTietDichVuDc"
                                          width="100%">
                                    <emptyStateComponent>
                                        <vbox width="100%" height="100%" alignItems="CENTER" justifyContent="CENTER">
                                            <icon icon="vaadin:file-o" size="48px" color="var(--lumo-tertiary-text-color)"/>
                                            <h2 text="Chưa có dữ liệu"/>
                                        </vbox>
                                    </emptyStateComponent>
                                    <actions>
                                        <action id="create" type="list_create" text="Thêm dịch vụ"/>
                                        <action id="edit" type="list_edit" text="Chi tiết"/>
                                        <action id="remove" type="list_remove" text="xóa"/>
                                        <action id="refresh" type="list_refresh"/>
                                    </actions>

                                    <columns resizable="true">
                                        <column property="idDichVu.tenDichVu"/>
                                        <column property="idDichVu.nhomDichVu"/>
                                        <column property="idDichVu.gia"/>
                                        <column property="soLuong" header="Số buổi"/>
                                        <column property="ngayBatDau"/>
                                    </columns>
                                </dataGrid>
                            </formLayout>
                        </vbox>
                    </vbox>

                    <vbox width="100%" alignItems="START" padding="false"
                          spacing="false" classNames="tab-5-grid">
                        <vbox spacing="false" padding="false" classNames="header-grid-auto-pay"
                              width="100%">
                            <hbox classNames="buttons-panel" width="100%">
                                <div width="100%" classNames="all-control-auto-pay">
                                    <div classNames="title-grid">
                                        <span text="THÔNG TIN THANH TOÁN"/>
                                    </div>
                                </div>
                            </hbox>
                        </vbox>
                        <vbox padding="false" classNames="grid-data">
                            <formLayout dataContainer="chiTietDieuTriDc"
                                        css="border: 1px #BFBFBF solid; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; padding: 20px">
                                <responsiveSteps>
                                    <responsiveStep minWidth="0" columns="6"/>
                                </responsiveSteps>
                                <textField id="tongTienField" property="tongTien" readOnly="true"/>
                                <textField id="khuyenMaiField" property="khuyenMai"/>
                                <textField id="tongTienSauKhuyenMaiField" property="tongTienSauKhuyenMai" readOnly="true"/>
                                <textField id="daThanhToanField" property="daThanhToan" readOnly="true"/>
                                <textField id="phaiDongField" property="phaiDong" readOnly="true"/>
                                <datePicker id="ngayThanhToanField" property="ngayThanhToan" readOnly="true"/>
                            </formLayout>
                        </vbox>
                    </vbox>

                    <vbox width="100%" alignItems="START" padding="false"
                          spacing="false" classNames="tab-5-grid">
                        <vbox spacing="false" padding="false" classNames="header-grid-auto-pay"
                              width="100%">
                            <hbox classNames="buttons-panel" width="100%">
                                <div width="100%" classNames="all-control-auto-pay">
                                    <div classNames="title-grid">
                                        <span text="LỊCH SỬ THANH TOÁN"/>
                                    </div>
                                    <div classNames="function-flex-end">
                                        <button action="lichSuThanhToansDataGrid.create" classNames="action-button"/>
                                        <button action="lichSuThanhToansDataGrid.refresh" classNames="action-button"/>
                                    </div>
                                </div>
                            </hbox>
                        </vbox>
                        <vbox padding="false" classNames="grid-data">
                            <formLayout
                                    css="border: 1px #BFBFBF solid; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; padding: 20px">
                                <responsiveSteps>
                                    <responsiveStep minWidth="0" columns="1"/>
                                </responsiveSteps>
                                <dataGrid id="lichSuThanhToansDataGrid" dataContainer="lichSuThanhToansDc" minWidth="100px"
                                          width="100%">
                                    <emptyStateComponent>
                                        <vbox width="100%" height="100%" alignItems="CENTER" justifyContent="CENTER">
                                            <icon icon="vaadin:file-o" size="48px" color="var(--lumo-tertiary-text-color)"/>
                                            <h2 text="Chưa có dữ liệu"/>
                                        </vbox>
                                    </emptyStateComponent>
                                    <actions>
                                        <action id="create" type="list_create" text="Thanh toán"/>
                                        <action id="edit" type="list_edit" text="Chi tiết"/>
                                        <action id="remove" type="list_remove" text="Xóa"/>
                                        <action id="refresh" type="list_refresh"/>
                                    </actions>
                                    <columns resizable="true">
                                        <column property="thanhToanLuc"/>
                                        <column property="daThanhToan"/>
                                        <column property="ghiChu"/>
                                        <column property="hoTenNguoiNopTien"/>
                                        <column property="soDienThoai"/>
                                    </columns>
                                </dataGrid>


                            </formLayout>
                        </vbox>
                    </vbox>

                    <vbox width="100%" alignItems="START" padding="false"
                          spacing="false" classNames="tab-5-grid">
                        <vbox spacing="false" padding="false" classNames="header-grid-auto-pay"
                              width="100%">
                            <hbox classNames="buttons-panel" width="100%">
                                <div width="100%" classNames="all-control-auto-pay">
                                    <div classNames="title-grid">
                                        <span text="KPI &amp; TRỌNG SỐ"/>
                                    </div>
                                </div>
                            </hbox>
                        </vbox>
                        <vbox padding="false" classNames="grid-data">
                            <formLayout dataContainer="chiTietDieuTriDc"
                                    css="border: 1px #BFBFBF solid; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; padding: 20px">
                                <responsiveSteps>
                                    <responsiveStep minWidth="0" columns="2"/>
                                </responsiveSteps>
                                <textField id="trongSoKPIField" property="trongSoKpi" colspan="2"/>
                                <textField id="trongSoVatLyTriLieuField" property="trongSoVatLyTriLieu"/>
                                <textField id="trongSoVanDongTriLieuField" property="trongSoVanDongTriLieu"/>
                                <textField id="trongSoKeoNanTriLieuField" property="trongSoKeoNanTriLieu"/>
                                <textField id="trongSoXoaBopTriLieuField" property="trongSoXoaBopTriLieu"/>
                                <textField id="trongSoKhamLuongGiaField" property="trongSoKhamLuongGia"/>
                            </formLayout>
                        </vbox>
                    </vbox>

                </vbox>
            </tab>
            <tab id="tab2" label="TỔNG KẾT ĐIỀU TRỊ">
                <vbox>
                    <vbox width="100%" alignItems="START" padding="false"
                          spacing="false" classNames="tab-5-grid">
                        <vbox spacing="false" padding="false" classNames="header-grid-auto-pay"
                              width="100%">
                            <hbox classNames="buttons-panel" width="100%">
                                <div width="100%" classNames="all-control-auto-pay">
                                    <div classNames="title-grid">
                                        <span text="TỔNG KẾT ĐIỀU TRỊ"/>
                                    </div>
                                </div>
                            </hbox>
                        </vbox>
                        <vbox padding="false" classNames="grid-data">
                            <formLayout dataContainer="chiTietDieuTriDc"
                                        css="border: 1px #BFBFBF solid; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; padding: 20px">
                                <responsiveSteps>
                                    <responsiveStep minWidth="0" columns="2"/>
                                </responsiveSteps>
                                <textArea id="dienBienBenhField" height="9.5em" property="dienBienBenh" colspan="2" />
                                <timePicker id="chuanDoanRaVienField" property="chuanDoanRaVien" colspan="2" />
                                <textField id="tinhTrangBenhNhanField" property="tinhTrangBenhNhan" colspan="2" label="Tình trạng bệnh nhân ra viện"/>
                                <textArea id="huongDieuTriField" height="9.5em" property="huongDieuTri" colspan="2" label="Hướng điều trị và các chế độ tiếp theo"/>
                                <textField id="ngayBatDauField" property="ngayBatDau" label="Ngày bắt đầu"/>
                                <textField id="ngayKetThucField" property="ngayKetThuc" label="Ngày kết thúc"/>
                            </formLayout>
                        </vbox>
                    </vbox>
                </vbox>
            </tab>
        </tabSheet>


        <hbox id="detailActions" justifyContent="END" alignItems="END" alignSelf="END">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
