<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://lichHenListView.title"
      focusComponent="lichHensDataGrid">
    <data>
        <collection id="lichHensDc"
                    class="com.company.clinicportal.entity.LichHen">
            <fetchPlan extends="_base">
                <property name="id"/>
                <property name="idBenhNhan" fetchPlan="_base">
                </property>
            </fetchPlan>
            <loader id="lichHensDl" readOnly="true">
                <query>
                    <![CDATA[
                        select e
                        from LichHen e
                        where e.ngayHen = :currentDate
                    ]]>
                </query>
            </loader>
        </collection>
        <collection id="lichHensDc_1" class="com.company.clinicportal.entity.LichHen">
            <loader id="lichHensDl_1" readOnly="true">
                <query>
                    <![CDATA[select e from LichHen e]]>
                </query>
            </loader>
            <fetchPlan extends="_base">
                <property name="idBenhNhan" fetchPlan="_base">
                    <property name="hoVaTen"/>
                </property>
            </fetchPlan>
        </collection>


    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <genericFilter component="genericFilter2"/>
            <pagination component="pagination"/>
            <pagination component="pagination2"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <tabSheet width="100%" id="tabSheet" classNames="styled-tabs">
            <tab id="tab1" label="Lịch hẹn mới">
                <vbox>
                    <genericFilter id="genericFilter"
                                   dataLoader="lichHensDl" opened="false">
                        <properties include=".*"/>
                    </genericFilter>
                    <hbox id="buttonsPanel" classNames="buttons-panel" justifyContent="END">
                        <button id="createButton" action="lichHensDataGrid.createAction" text="Thêm lịch"/>
                        <button id="refreshButton" action="lichHensDataGrid.refreshAction" text="Làm mới"/>
                    </hbox>
                    <dataGrid id="lichHensDataGrid"
                              width="100%"
                              minHeight="20em"
                              dataContainer="lichHensDc"
                              columnReorderingAllowed="true">
                        <emptyStateComponent>
                            <vbox width="100%" height="100%" alignItems="CENTER" justifyContent="CENTER">
                                <icon icon="vaadin:file-o" size="48px" color="var(--lumo-tertiary-text-color)"/>
                                <h2 text="Chưa có dữ liệu"/>
                            </vbox>
                        </emptyStateComponent>
                        <actions>
                            <action id="createAction" type="list_create">
                                <properties><property name="openMode" value="DIALOG"/></properties>
                            </action>
                            <action id="editAction" type="list_edit"/>
                            <action id="removeAction" type="list_remove"/>
                            <action id="refreshAction" type="list_refresh"/>
                        </actions>
                        <columns resizable="true">
                            <column property="idBenhNhan.hoVaTen" header="Họ tên bệnh nhân"/>
                            <column property="idBenhNhan.tuoi" header="Tuổi"/>
                            <column property="idBenhNhan.dienThoai" header="Số ĐT liên lạc"/>
                            <column property="tinhTrangBenh"/>
                            <column property="nhuCauKhachHang"/>
                            <column property="hinhThuc" header="Hình thức khám"/>
                        </columns>
                    </dataGrid>
                    <simplePagination id="pagination" dataLoader="lichHensDl" alignSelf="END"/>
                    <hbox id="lookupActions" visible="false">
                        <button id="selectButton" action="selectAction"/>
                        <button id="discardButton" action="discardAction"/>
                    </hbox>
                </vbox>
            </tab>
            <tab id="tab2" label="Toàn bộ">
                <vbox>
                    <genericFilter id="genericFilter2"
                                   dataLoader="lichHensDl_1" opened="false">
                        <properties include=".*"/>
                    </genericFilter>
                    <dataGrid id="lichHensDataGrid2"
                              width="100%"
                              minHeight="20em"
                              dataContainer="lichHensDc_1"
                              columnReorderingAllowed="true">
                        <emptyStateComponent>
                            <vbox width="100%" height="100%" alignItems="CENTER" justifyContent="CENTER">
                                <icon icon="vaadin:file-o" size="48px" color="var(--lumo-tertiary-text-color)"/>
                                <h2 text="Chưa có dữ liệu"/>
                            </vbox>
                        </emptyStateComponent>
                        <actions>
                            <action id="createAction" type="list_create">
                                <properties><property name="openMode" value="DIALOG"/></properties>
                            </action>
                            <action id="editAction" type="list_edit"/>
                            <action id="removeAction" type="list_remove"/>
                        </actions>
                        <columns resizable="true">
                            <column property="idBenhNhan.hoVaTen" header="Họ tên bệnh nhân"/>
                            <column property="idBenhNhan.tuoi" header="Tuổi"/>
                            <column property="idBenhNhan.dienThoai" header="Số điện thoại"/>
                            <column property="ngayHen"/>
                            <column property="thoiGianHen"/>
                            <column property="tinhTrangBenh"/>
                            <column property="nhuCauKhachHang"/>
                            <column property="hinhThuc" header="Hình thức khám"/>
                        </columns>
                    </dataGrid>
                    <simplePagination id="pagination2" dataLoader="lichHensDl_1" alignSelf="END"/>

                    <hbox id="lookupActions2" visible="false">
                        <button id="selectButton2" action="selectAction"/>
                        <button id="discardButton2" action="discardAction"/>
                    </hbox>
                </vbox>
            </tab>
        </tabSheet>



    </layout>
</view>
