<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://tinhKpiDetailView.title"
      focusComponent="form">
    <data>
        <instance id="tinhKpiDc"
                  class="com.company.clinicportal.entity.TinhKpi">
            <fetchPlan extends="_base">
                <property name="id"/>
            </fetchPlan>
            <loader id="tinhKpiDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="tinhKpiDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <dateTimePicker id="createdAtField" property="createdAt"/>
            <textField id="createdByIdField" property="createdById"/>
            <textField id="idLuongThangField" property="idLuongThang"/>
            <textField id="idNhanSuField" property="idNhanSu"/>
            <textField id="kpiSangField" property="kpiSang"/>
            <textField id="kpiToiField" property="kpiToi"/>
            <textField id="kpiTongField" property="kpiTong"/>
            <datePicker id="thangField" property="thang"/>
            <textField id="thanhTienField" property="thanhTien"/>
            <dateTimePicker id="updatedAtField" property="updatedAt"/>
            <textField id="updatedByIdField" property="updatedById"/>
        </formLayout>
        <hbox id="detailActions" justifyContent="END" alignItems="END" alignSelf="END">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
