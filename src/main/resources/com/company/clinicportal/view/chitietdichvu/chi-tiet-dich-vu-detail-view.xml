<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://chiTietDichVuDetailView.title"
      focusComponent="form">
    <data>
        <instance id="chiTietDichVuDc"
                  class="com.company.clinicportal.entity.ChiTietDichVu">
            <fetchPlan extends="_base">
                <property name="id"/>
                <property name="idDichVu" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="chiTietDichVuDl"/>
        </instance>
        <collection id="dmDichVusDc" class="com.company.clinicportal.entity.DmDichVu">
            <loader id="dmDichVusDl" readOnly="true">
                <query>
                    <![CDATA[select e from DmDichVu e]]>
                </query>
            </loader>
            <fetchPlan extends="_base"/>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="chiTietDichVuDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <entityComboBox id="idDichVuField" property="idDichVu" itemsContainer="dmDichVusDc" label="msg:///dichVu" required="true"/>
            <textField id="soLuongField" property="soLuong" label="msg:///soBuoi" required="true"/>
            <textField id="giaField" property="idDichVu.gia" label="msg:///gia" readOnly="true"/>
            <textField id="donViTinhField" property="idDichVu.donViTinh" label="msg:///donViTinh" readOnly="true"/>
            <datePicker id="ngayBatDauField" property="ngayBatDau" required="true"/>
            <textField id="khoangCachBuoiDieuTriField" property="khoangCachBuoiDieuTri" required="true"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
