<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://chiTietDichVuListView.title"
      focusComponent="chiTietDichVusDataGrid">
    <data>
        <collection id="chiTietDichVusDc"
                    class="com.company.clinicportal.entity.ChiTietDichVu">
            <fetchPlan extends="_base">
                <property name="id"/>
                <property name="idDichVu" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="chiTietDichVusDl" readOnly="true">
                <query>
                    <![CDATA[select e from ChiTietDichVu e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="chiTietDichVusDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createButton" action="chiTietDichVusDataGrid.createAction"/>
            <button id="editButton" action="chiTietDichVusDataGrid.editAction"/>
            <button id="removeButton" action="chiTietDichVusDataGrid.removeAction"/>
            <simplePagination id="pagination" dataLoader="chiTietDichVusDl"/>
        </hbox>
        <dataGrid id="chiTietDichVusDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="chiTietDichVusDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="idDichVu.tenDichVu"/>
                <column property="khoangCachBuoiDieuTri"/>
                <column property="ngayBatDau"/>
                <column property="soLuong"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
