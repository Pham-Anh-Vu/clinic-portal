<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://icd10ListView.title"
      focusComponent="icd10sDataGrid">
    <data readOnly="true">
        <collection id="icd10sDc" class="com.company.clinicportal.entity.Icd10">
            <fetchPlan extends="_base"/>
            <loader id="icd10sDl" readOnly="true">
                <query>
                    <![CDATA[select e from Icd10 e order by e.maIcd]]>
                </query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <layout>
        <genericFilter id="genericFilter" dataLoader="icd10sDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createButton" action="icd10sDataGrid.createAction"/>
            <button id="editButton" action="icd10sDataGrid.editAction"/>
            <button id="removeButton" action="icd10sDataGrid.removeAction"/>
            <button id="importButton" text="Import Excel" icon="vaadin:upload"/>
            <simplePagination id="pagination" dataLoader="icd10sDl"/>
        </hbox>
        <dataGrid id="icd10sDataGrid"
                  width="100%"
                  columnReorderingAllowed="true"
                  minHeight="20em"
                  dataContainer="icd10sDc">
            <emptyStateComponent>
                <vbox width="100%" height="100%" alignItems="CENTER" justifyContent="CENTER">
                    <icon icon="vaadin:file-o" size="48px" color="var(--lumo-tertiary-text-color)"/>
                    <h2 text="Chưa có dữ liệu"/>
                </vbox>
            </emptyStateComponent>
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="maIcd"/>
                <column property="tenBenh"/>
                <column property="tenBenhEn"/>
                <column property="chuong"/>
                <column property="nhomChinh"/>
                <column property="nhomPhu"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
