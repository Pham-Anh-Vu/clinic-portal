<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://dmThuocListView.title"
      focusComponent="dmThuocsDataGrid">
    <data readOnly="true">
        <collection id="dmThuocsDc"
                    class="com.company.clinicportal.entity.DmThuoc">
            <fetchPlan extends="_base"/>
            <loader id="dmThuocsDl" readOnly="true">
                <query>
                    <![CDATA[select e from DmThuoc e order by e.maThuoc]]>
                </query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <layout>
        <vbox spacing="true" width="100%" height="100%">
            <vbox spacing="false" width="100%"
                  css="border: 1px solid var(--lumo-contrast-20pct); border-radius: 8px; padding: 16px; background: var(--lumo-base-color);">
                <hbox width="100%" alignItems="CENTER" justifyContent="BETWEEN"
                      css="margin-bottom: 12px; padding-bottom: 12px; border-bottom: 2px solid var(--lumo-primary-color);">
                    <hbox spacing="true" alignItems="CENTER">
                        <icon icon="vaadin:pill" size="20px"
                              color="var(--lumo-primary-color)"/>
                        <h3 text="DANH MỤC THUỐC"
                            css="margin: 0; color: var(--lumo-primary-color); font-weight: bold;"/>
                    </hbox>
                </hbox>
                <genericFilter id="genericFilter"
                               dataLoader="dmThuocsDl" opened="false">
                    <properties include=".*"/>
                </genericFilter>
                <hbox id="buttonsPanel" classNames="buttons-panel" justifyContent="END" css="margin-top: 8px;">
                    <button id="importButton" text="Import" icon="vaadin:upload"/>
                    <button id="createButton" action="dmThuocsDataGrid.createAction" icon="vaadin:plus"/>
                    <button id="refreshButton" action="dmThuocsDataGrid.refreshAction" icon="vaadin:refresh"/>
                </hbox>
                <dataGrid id="dmThuocsDataGrid"
                          width="100%"
                          minHeight="20em"
                          dataContainer="dmThuocsDc"
                          columnReorderingAllowed="true">
                    <emptyStateComponent>
                        <vbox width="100%" height="100%" alignItems="CENTER" justifyContent="CENTER">
                            <icon icon="vaadin:file-o" size="48px" color="var(--lumo-tertiary-text-color)"/>
                            <h2 text="Chưa có dữ liệu"/>
                        </vbox>
                    </emptyStateComponent>
                    <actions>
                        <action id="createAction" type="list_create" text="Thêm thuốc">
                            <properties>
                                <property name="openMode" value="DIALOG"/>
                            </properties>
                        </action>
                        <action id="editAction" type="list_edit" text="Cập nhật"/>
                        <action id="removeAction" type="list_remove" text="Xóa"/>
                        <action id="refreshAction" type="list_refresh"/>
                    </actions>
                    <columns resizable="true">
                        <column property="maThuoc"/>
                        <column property="tenThuoc"/>
                        <column property="bietDuoc"/>
                        <column property="hoatChat"/>
                        <column property="donViTinh"/>
                        <column property="hamLuong" header="Hoạt chất"/>
                    </columns>
                </dataGrid>
                <simplePagination id="pagination" dataLoader="dmThuocsDl" alignSelf="END" css="margin-top: 8px;"/>
            </vbox>

            <hbox id="lookupActions" visible="false">
                <button id="selectButton" action="selectAction"/>
                <button id="discardButton" action="discardAction"/>
            </hbox>
        </vbox>
    </layout>
</view>
