<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://phieuThuThapListView.title"
      focusComponent="phieuThuThapsDataGrid">
    <data>
        <collection id="phieuThuThapsDc"
                    class="com.company.clinicportal.entity.PhieuThuThap">
            <fetchPlan extends="_base"/>
            <loader id="phieuThuThapsDl" readOnly="true">
                <query>
                    <![CDATA[select e from PhieuThuThap e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="phieuThuThapsDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createButton" action="phieuThuThapsDataGrid.createAction"/>
            <button id="editButton" action="phieuThuThapsDataGrid.editAction"/>
            <button id="readButton" action="phieuThuThapsDataGrid.readAction"/>
            <button id="refreshButton" action="phieuThuThapsDataGrid.refreshAction"/>
            <button id="removeButton" action="phieuThuThapsDataGrid.removeAction"/>
            <button id="reportButton" action="phieuThuThapsDataGrid.reportAction" enabled="true"/>
            <simplePagination id="pagination" dataLoader="phieuThuThapsDl"/>
        </hbox>
        <dataGrid id="phieuThuThapsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="phieuThuThapsDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="readAction" type="list_read"/>
                <action id="refreshAction" type="list_refresh"/>
                <action id="removeAction" type="list_remove"/>
                <action id="reportAction" type="report_runListEntityReport"/>
            </actions>
            <columns resizable="true">
                <column property="hoVaten"/>
                <column property="ngayThangNamSinh"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
