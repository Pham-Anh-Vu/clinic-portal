<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://phieuThuThapDetailView1.title"
      focusComponent="form">
    <data>
        <instance id="phieuThuThapDc"
                  class="com.company.clinicportal.entity.PhieuThuThap">
            <fetchPlan extends="_base">
                <property name="quaTrinhHoatDongs" fetchPlan="_base"/>
            </fetchPlan>

            <collection id="quaTrinhHoatDongs"
                        property="quaTrinhHoatDongs"/>
            <loader id="phieuThuThapDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="phieuThuThapDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="hoVatenField" property="hoVaten"/>
            <textField id="hoVaTenKhaiSinhField" property="hoVaTenKhaiSinh"/>
            <textField id="ngayThangNamSinhField" property="ngayThangNamSinh"/>
            <textField id="gioiTinhField" property="gioiTinh"/>
            <textField id="danTocField" property="danToc"/>
            <textField id="quocTichField" property="quocTich"/>
            <textField id="soCanCuocCongDanField" property="soCanCuocCongDan"/>
            <textField id="ngayCapField" property="ngayCap"/>
            <textField id="noiCapField" property="noiCap"/>
            <textField id="queQuanField" property="queQuan"/>
            <textField id="noiThuongTruField" property="noiThuongTru"/>
            <textField id="noiOHienTaiField" property="noiOHienTai"/>
            <textField id="trinhDoHocVanField" property="trinhDoHocVan"/>
            <textField id="trinhDoChuyenMonField" property="trinhDoChuyenMon"/>
            <textField id="trinhDoDaoTaoTonGiaoField" property="trinhDoDaoTaoTonGiao"/>
            <textField id="coSoDaoTaoTonGiaoField" property="coSoDaoTaoTonGiao"/>
            <textField id="ngoaiNguField" property="ngoaiNgu"/>
            <hbox id="buttonsPanel" classNames="buttons-panel" justifyContent="END">
                <button id="createButton" action="usersDataGrid.createAction"/>
                <button id="refreshButton" action="usersDataGrid.editAction"/>
            </hbox>
            <dataGrid id="usersDataGrid" dataContainer="quaTrinhHoatDongs" colspan="2"
                      width="100%"
                      columnReorderingAllowed="true"
                      minHeight="20em"
                      >
                <emptyStateComponent>
                    <vbox width="100%" height="100%" alignItems="CENTER" justifyContent="CENTER">
                        <icon icon="vaadin:file-o" size="48px" color="var(--lumo-tertiary-text-color)"/>
                        <h2 text="Chưa có dữ liệu"/>
                    </vbox>
                </emptyStateComponent>
                <actions>
                    <action id="createAction" type="list_create"/>
                    <action id="editAction" type="list_edit"/>
                    <action id="removeAction" type="list_remove"/>
                </actions>
                <columns resizable="true">
                    <column property="chucVuDamNhan"/>
                    <column property="thoiGian"/>
                    <column property="diaDiemHoatDong"/>
                    <column property="loaiHoatDong"/>
                </columns>
            </dataGrid>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
