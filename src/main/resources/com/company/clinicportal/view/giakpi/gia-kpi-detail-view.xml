<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://giaKpiDetailView.title"
      focusComponent="form">
    <data>
        <instance id="giaKpiDc"
                  class="com.company.clinicportal.entity.GiaKpi">
            <fetchPlan extends="_base">
                <property name="id"/>
            </fetchPlan>
            <loader id="giaKpiDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="giaKpiDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <select id="loaiField" property="loai"/>
            <textField id="giaField" property="gia"/>
        </formLayout>
        <hbox id="detailActions" justifyContent="END" alignItems="END" alignSelf="END">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
