<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://trangThaiBenhNhanDetailView.title"
      focusComponent="form">
    <data>
        <instance id="benhNhanDc"
                  class="com.company.clinicportal.entity.BenhNhan">
            <fetchPlan extends="_base">
                <property name="trangThaiKhamBenh"/>
                <property name="ngayKhamBenh"/>
                <property name="thoiGianTaiKham"/>
            </fetchPlan>
            <loader id="benhNhanDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="benhNhanDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <select id="trangThaiKhamBenhField" property="trangThaiKhamBenh"/>
            <datePicker id="ngayKhamBenhField" property="ngayKhamBenh"/>
            <datePicker id="thoiGianTaiKhamField" property="thoiGianTaiKham"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
