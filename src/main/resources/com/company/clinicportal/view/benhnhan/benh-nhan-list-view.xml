<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://benhNhanListView.title"
      focusComponent="benhNhansDataGrid">
    <data>
        <collection id="benhNhansDc"
                    class="com.company.clinicportal.entity.BenhNhan">
            <fetchPlan extends="_base">
                <property name="id"/>
            </fetchPlan>
            <loader id="benhNhansDl" readOnly="true">
                <query>
                    <![CDATA[select e from BenhNhan e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="benhNhansDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createButton" action="benhNhansDataGrid.createAction"/>
            <button id="editButton" action="benhNhansDataGrid.editAction"/>
            <button id="removeButton" action="benhNhansDataGrid.removeAction"/>
            <simplePagination id="pagination" dataLoader="benhNhansDl"/>
        </hbox>
        <dataGrid id="benhNhansDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="benhNhansDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="createdAt"/>
                <column property="createdById"/>
                <column property="diaChi"/>
                <column property="dienThoai"/>
                <column property="gioiTinh"/>
                <column property="hoTenNguoiThan"/>
                <column property="hoVaTen"/>
                <column property="ngaySinh"/>
                <column property="nguoiGioiThieu"/>
                <column property="nguonBenhNhan"/>
                <column property="quanHeVoiBenhNhan"/>
                <column property="sdtNguoiThan"/>
                <column property="tuoi"/>
                <column property="updatedAt"/>
                <column property="updatedById"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
