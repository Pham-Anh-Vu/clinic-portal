<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://quaTrinhHoatDongDetailView.title"
      focusComponent="form">
    <data>
        <instance id="quaTrinhHoatDongDc"
                  class="com.company.clinicportal.entity.QuaTrinhHoatDong">
            <fetchPlan extends="_base"/>
            <loader id="quaTrinhHoatDongDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="quaTrinhHoatDongDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="tenField" property="ten"/>
            <textField id="cccdField" property="cccd"/>
            <textField id="thoiGianField" property="thoiGian"/>
            <textField id="loaiHoatDongField" property="loaiHoatDong"/>
            <textField id="diaDiemHoatDongField" property="diaDiemHoatDong"/>
            <textField id="chucVuDamNhanField" property="chucVuDamNhan"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
