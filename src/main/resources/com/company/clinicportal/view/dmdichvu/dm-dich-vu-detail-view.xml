<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://dmDichVuDetailView.title"
      focusComponent="form">
    <data>
        <instance id="dmDichVuDc"
                  class="com.company.clinicportal.entity.DmDichVu">
            <fetchPlan extends="_base">
                <property name="id"/>
                <property name="idChiTietDichVu" fetchPlan="_base">
                </property>
            </fetchPlan>
            <loader id="dmDichVuDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="dmDichVuDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="tenDichVuField" property="tenDichVu"/>
            <select id="nhomDichVuField" property="nhomDichVu" required="true"/>
            <textArea id="moTaField" height="9.5em" property="moTa" colspan="2"/>
            <textField id="giaField" property="gia"/>
            <textField id="giaLeField" property="giaBuoiLe"/>
            <textField id="giaKpiSangField" property="giaKpiSang" required="true"/>
            <textField id="giaKpiToiField" property="giaKpiToi" required="true"/>
            <textField id="donViTinhField" property="donViTinh"/>


        </formLayout>
        <hbox id="detailActions" justifyContent="END" alignItems="END" alignSelf="END">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
