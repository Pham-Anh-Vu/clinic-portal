<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="Bảng giá dịch vụ"
      focusComponent="dmDichVusDataGrid">
    <data>
        <collection id="dmDichVusDc"
                    class="com.company.clinicportal.entity.DmDichVu">
            <fetchPlan extends="_base">
                <property name="id"/>
            </fetchPlan>
            <loader id="dmDichVusDl" readOnly="true">
                <query>
                    <![CDATA[select e from DmDichVu e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="dmDichVusDl" opened="false">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel" justifyContent="END">
            <button id="createButton" action="dmDichVusDataGrid.createAction"/>
            <button id="refreshButton" action="dmDichVusDataGrid.refreshAction"/>
        </hbox>
        <dataGrid id="dmDichVusDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="dmDichVusDc"
                  columnReorderingAllowed="true">
            <emptyStateComponent>
                <vbox width="100%" height="100%" alignItems="CENTER" justifyContent="CENTER">
                    <icon icon="vaadin:file-o" size="48px" color="var(--lumo-tertiary-text-color)"/>
                    <h2 text="Chưa có dữ liệu"/>
                </vbox>
            </emptyStateComponent>
            <actions>
                <action id="createAction" type="list_create" text="Thêm dịch vụ">
                    <properties><property name="openMode" value="DIALOG"/></properties>
                </action>
                <action id="editAction" type="list_edit" text="Cập nhật"/>
                <action id="removeAction" type="list_remove" text="Xóa"/>
                <action id="refreshAction" type="list_refresh"/>
            </actions>
            <columns resizable="true">
                <column property="tenDichVu"/>
                <column property="nhomDichVu"/>
                <column property="moTa"/>
                <column property="gia"/>
                <column property="giaKpiSang"/>
                <column property="giaKpiToi"/>
                <column property="donViTinh"/>
            </columns>
        </dataGrid>
        <simplePagination id="pagination" dataLoader="dmDichVusDl" alignSelf="END"/>

        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
