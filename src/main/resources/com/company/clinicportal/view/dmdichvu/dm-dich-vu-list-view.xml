<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="Bảng giá dịch vụ"
      focusComponent="dmDichVusDataGrid">
    <data>
        <collection id="dmDichVusDc"
                    class="com.company.clinicportal.entity.DmDichVu">
            <fetchPlan extends="_base">
                <property name="id"/>
            </fetchPlan>
            <loader id="dmDichVusDl" readOnly="true">
                <query>
                    <![CDATA[select e from DmDichVu e order by e.createdAt desc]]>
                </query>
            </loader>
        </collection>

        <collection id="giaKpiDc"
                    class="com.company.clinicportal.entity.GiaKpi">
            <fetchPlan extends="_base">
                <property name="id"/>
            </fetchPlan>
            <loader id="giaKpiDl" readOnly="true">
                <query>
                    <![CDATA[select e from GiaKpi e order by e.createdAt desc]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <vbox spacing="true" width="100%" height="100%">
            <!-- Vùng 1: Danh mục dịch vụ -->
            <vbox spacing="false" width="100%" 
                  css="border: 1px solid var(--lumo-contrast-20pct); border-radius: 8px; padding: 16px; background: var(--lumo-base-color);">
                <hbox width="100%" alignItems="CENTER" justifyContent="BETWEEN"
                      css="margin-bottom: 12px; padding-bottom: 12px; border-bottom: 2px solid var(--lumo-primary-color);">
                    <h3 text="DANH MỤC DỊCH VỤ" 
                        css="margin: 0; color: var(--lumo-primary-color); font-weight: bold;"/>
                </hbox>
                <genericFilter id="genericFilter"
                               dataLoader="dmDichVusDl" opened="false">
                    <properties include=".*"/>
                </genericFilter>
                <hbox id="buttonsPanel" classNames="buttons-panel" justifyContent="END" css="margin-top: 8px;">
                    <button id="importButton" text="Import"/>
                    <button id="createButton" action="dmDichVusDataGrid.createAction"/>
                    <button id="refreshButton" action="dmDichVusDataGrid.refreshAction"/>
                </hbox>
                <dataGrid id="dmDichVusDataGrid"
                          width="100%"
                          minHeight="25em"
                          dataContainer="dmDichVusDc"
                          columnReorderingAllowed="true">
                    <emptyStateComponent>
                        <vbox width="100%" height="100%" alignItems="CENTER" justifyContent="CENTER">
                            <icon icon="vaadin:file-o" size="48px" color="var(--lumo-tertiary-text-color)"/>
                            <h2 text="Chưa có dữ liệu"/>
                        </vbox>
                    </emptyStateComponent>
                    <actions>
                        <action id="createAction" type="list_create" text="Thêm dịch vụ">
                            <properties><property name="openMode" value="DIALOG"/></properties>
                        </action>
                        <action id="editAction" type="list_edit" text="Cập nhật"/>
                        <action id="removeAction" type="list_remove" text="Xóa"/>
                        <action id="refreshAction" type="list_refresh"/>
                    </actions>
                    <columns resizable="true">
                        <column property="tenDichVu"/>
                        <column property="nhomDichVu"/>
                        <column property="moTa"/>
                        <column property="gia"/>
                        <column property="giaBuoiLe"/>
                        <column property="giaKpiSang"/>
                        <column property="giaKpiToi"/>
                        <column property="donViTinh"/>
                    </columns>
                </dataGrid>
                <simplePagination id="pagination" dataLoader="dmDichVusDl" alignSelf="END" css="margin-top: 8px;"/>
            </vbox>

            <!-- Vùng 2: Giá KPI -->
            <vbox spacing="false" width="100%" 
                  css="border: 1px solid var(--lumo-contrast-20pct); border-radius: 8px; padding: 16px; background: var(--lumo-base-color); margin-top: 16px;">
                <hbox width="100%" alignItems="CENTER" justifyContent="BETWEEN"
                      css="margin-bottom: 12px; padding-bottom: 12px; border-bottom: 2px solid var(--lumo-success-color);">
                    <h3 text="GIÁ KPI"
                        css="margin: 0; color: var(--lumo-primary-color); font-weight: bold;"/>
                </hbox>
                <hbox id="buttonsPanel1" classNames="buttons-panel" justifyContent="END" css="margin-bottom: 8px;">
                    <button id="editBtn1" action="giaKpiDataGrid.editAction"/>
                    <button id="refreshButton1" action="giaKpiDataGrid.refreshAction"/>
                </hbox>
                <dataGrid id="giaKpiDataGrid"
                          width="100%"
                          minHeight="15em"
                          dataContainer="giaKpiDc"
                          columnReorderingAllowed="true">
                    <emptyStateComponent>
                        <vbox width="100%" height="100%" alignItems="CENTER" justifyContent="CENTER">
                            <icon icon="vaadin:file-o" size="48px" color="var(--lumo-tertiary-text-color)"/>
                            <h2 text="Chưa có dữ liệu"/>
                        </vbox>
                    </emptyStateComponent>
                    <actions>
                        <action id="editAction" type="list_edit" text="Cập nhật">
                            <properties>
                                <property name="openMode" value="DIALOG"/>
                            </properties>
                        </action>
                        <action id="removeAction" type="list_remove" text="Xóa"/>
                        <action id="refreshAction" type="list_refresh"/>
                    </actions>
                    <columns resizable="true">
                        <column property="loai"/>
                        <column property="gia"/>
                    </columns>
                </dataGrid>
            </vbox>

            <hbox id="lookupActions" visible="false">
                <button id="selectButton" action="selectAction"/>
                <button id="discardButton" action="discardAction"/>
            </hbox>
        </vbox>
    </layout>
</view>
