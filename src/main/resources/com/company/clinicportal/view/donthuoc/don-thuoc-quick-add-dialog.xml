<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://donThuocQuickAddDialog.title"
      focusComponent="formHeader">
    <data>
        <instance id="donThuocDc" class="com.company.clinicportal.entity.DonThuoc">
            <fetchPlan extends="_base">
                <property name="chiTiets" fetchPlan="_base"/>
                <property name="chanDoans" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="donThuocDl"/>
            <collection id="chiTietsDc" property="chiTiets"/>
            <collection id="chanDoansDc" property="chanDoans"/>
        </instance>
        <instance id="dotDungDc" class="com.company.clinicportal.entity.DonThuocDotDung">
            <fetchPlan extends="_base"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout expand="actionsBox" spacing="false" padding="false">
        <vbox width="100%" alignItems="START" padding="false"
              spacing="false" classNames="tab-5-grid">
            <vbox spacing="false" padding="false" classNames="header-grid-auto-pay"
                  width="100%">
                <hbox classNames="buttons-panel" width="100%">
                    <div width="100%" classNames="all-control-auto-pay">
                        <div classNames="title-grid">
                            <span text="THÔNG TIN ĐƠN THUỐC"/>
                            <span id="chanDoanCountLabel1" themeName="badge" visible="false"/>
                        </div>
                    </div>
                </hbox>
            </vbox>
            <vbox padding="false" classNames="grid-data">
                <formLayout id="form" dataContainer="donThuocDc" css="border: 1px #BFBFBF solid; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; padding: 20px">
                    <responsiveSteps>
                        <responsiveStep minWidth="0" columns="1"/>
                        <responsiveStep minWidth="60em" columns="6"/>
                    </responsiveSteps>
                    <!--                <textField property="maDonThuoc" readOnly="true"/>-->
                    <select id="loaiDonField" property="loaiDon" label="Loại đơn"
                            optionsEnum="com.company.clinicportal.enumentity.LoaiDon" required="true" colspan="2"/>
                    <textField property="tenBacSi" colspan="2" required="true" readOnly="true"/>
                    <dateTimePicker id="ngayKeField" property="ngayKe" label="Ngày kê" required="true" colspan="2"/>
                    <select id="hinhThucDieuTriField" property="hinhThucDieuTri" label="Hình thức điều trị"
                            optionsEnum="com.company.clinicportal.enumentity.HinhThucDieuTri" required="false" colspan="2"/>
                    <datePicker property="ngayTaiKham" colspan="2"/>
<!--                    <textArea property="chanDoanText" height="6em" required="true" colspan="2" label="Chẩn đoán"/>-->

                    <textField id="soDotField" property="soDot" label="Đợt" datatype="int" required="true"
                               dataContainer="dotDungDc" colspan="2"/>
                    <datePicker id="tuNgayField" property="tuNgay" label="Từ ngày" required="true"
                                dataContainer="dotDungDc" colspan="2"/>
                    <datePicker id="denNgayField" property="denNgay" label="Đến ngày" required="true"
                                dataContainer="dotDungDc" colspan="2"/>

                    <textArea id="lyDoKhamField" property="lyDoKham" colspan="3" height="5em" label="Lưu ý"/>
                    <textArea property="loiDan" colspan="3" height="6em"/>
                </formLayout>
            </vbox>
        </vbox>

        <vbox width="100%" alignItems="START" padding="false"
              spacing="false" classNames="tab-5-grid">
            <vbox spacing="false" padding="false" classNames="header-grid-auto-pay"
                  width="100%">
                <hbox classNames="buttons-panel" width="100%">
                    <div width="100%" classNames="all-control-auto-pay">
                        <div classNames="title-grid">
                            <span text="CHẨN ĐOÁN VÀ KẾT LUẬN   "/>
                            <span id="chanDoanCountLabel" themeName="badge" visible="false"/>
                        </div>
                    </div>
                </hbox>
            </vbox>
            <vbox padding="false" classNames="grid-data">
                <formLayout
                        css="border: 1px #BFBFBF solid; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; padding: 20px">
                    <responsiveSteps>
                        <responsiveStep minWidth="0" columns="1"/>
                    </responsiveSteps>
                    <dataGrid id="chanDoanDataGrid" width="100%" minHeight="140px" dataContainer="chanDoansDc" colspan="6">
                        <actions>
                            <action id="edit" type="list_edit" text="Chi tiết"/>
                            <action id="remove" type="list_remove" text="Xóa"/>
                        </actions>
                        <emptyStateComponent>
                            <vbox width="100%" height="100%" alignItems="CENTER" justifyContent="CENTER">
                                <icon icon="vaadin:file-o" size="36px" color="var(--lumo-tertiary-text-color)"/>
                                <span text="Chưa có chẩn đoán"/>
                            </vbox>
                        </emptyStateComponent>
                        <columns resizable="true">
                            <column property="stt" width="3em" header="STT"/>
                            <column property="maIcdSnapshot" header="Mã ICD" editable="false" width="7em"/>
                            <column property="tenIcdSnapshot" header="Tên bệnh" editable="false"/>
                            <column property="ketLuan" header="Kết luận" editable="true">
                            </column>
                        </columns>
                    </dataGrid>
                </formLayout>
            </vbox>
        </vbox >

        <vbox width="100%" alignItems="START" padding="false"
              spacing="false" classNames="tab-5-grid">
            <vbox spacing="false" padding="false" classNames="header-grid-auto-pay"
                  width="100%">
                <hbox classNames="buttons-panel" width="100%">
                    <div width="100%" classNames="all-control-auto-pay">
                        <div classNames="title-grid">
                            <span text="DANH SÁCH THUỐC"/>
                            <span id="thuocCountLabel" themeName="badge"  visible="false"/>
                        </div>
                        <div classNames="function-flex-end">
                            <button id="addThuocButton" text="Thêm thuốc" icon="vaadin:plus" themeName="primary"
                                    action="chiTietDataGrid.create"/>
                        </div>
                    </div>
                </hbox>
            </vbox>
            <vbox padding="false" classNames="grid-data">
                <formLayout
                        css="border: 1px #BFBFBF solid; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; padding: 20px">
                    <responsiveSteps>
                        <responsiveStep minWidth="0" columns="1"/>
                    </responsiveSteps>
                    <dataGrid id="chiTietDataGrid" width="100%" minHeight="220px" dataContainer="chiTietsDc"
                              css="padding: 8px 0 0 0;">
                        <actions>
                            <action id="create" type="list_create" text="Thêm thuốc"/>
                            <action id="edit" type="list_edit" text="Chi tiết"/>
                            <action id="remove" type="list_remove" text="Xóa"/>
                        </actions>
                        <emptyStateComponent>
                            <vbox width="100%" height="100%" alignItems="CENTER" justifyContent="CENTER">
                                <icon icon="vaadin:file-o" size="40px" color="var(--lumo-tertiary-text-color)"/>
                                <span text="Chưa có thuốc nào"/>
                            </vbox>
                        </emptyStateComponent>
                        <columns resizable="true">
                            <column property="stt" width="3em" header="STT"/>
                            <column property="tenThuocSnapshot" header="Thuốc"/>
                            <column property="maThuocSnapshot" header="Mã thuốc" width="8em"/>
                            <column property="donViTinhSnapshot" header="Đơn vị tính" width="7em"/>
                            <column property="soLuong" header="Số lượng" width="6em" editable="true">
                            </column>
                            <column property="cachDung" header="Cách dùng" editable="true">
                            </column>
                            <column key="actionsColumn" header="Thao tác" width="7em" flexGrow="0"/>
                        </columns>
                    </dataGrid>
                </formLayout>
            </vbox>
        </vbox>

        <hbox id="actionsBox" justifyContent="END" spacing="true" width="100%">
            <button id="cancelDonBtn" text="Huỷ đơn" icon="vaadin:close"/>
            <button id="saveDraftBtn" text="Lưu nháp" icon="vaadin:edit"/>
            <button id="issueBtn" text="Lưu &amp; phát hành" icon="vaadin:check" themeName="primary"/>
            <button id="closeBtn" text="Đóng" icon="vaadin:close-circle"/>
        </hbox>
    </layout>
</view>