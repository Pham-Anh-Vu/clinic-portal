<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://donThuocQuickAddDialog.title"
      focusComponent="formHeader">
    <data>
        <instance id="donThuocDc" class="com.company.clinicportal.entity.DonThuoc">
            <fetchPlan extends="_base">
                <property name="chiTiets" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="donThuocDl"/>
        </instance>
        <collection id="chiTietsDc" class="com.company.clinicportal.entity.DonThuocChiTiet">
            <fetchPlan extends="_base"/>
            <loader id="chiTietsDl">
                <query>
                    <![CDATA[select e from DonThuocChiTiet e where e.donThuoc = :donThuoc order by e.stt]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout expand="actionsBox" spacing="false" padding="false">
        <vbox id="formHeader" width="100%" spacing="true" padding="true">
            <formLayout id="form" dataContainer="donThuocDc">
                <responsiveSteps>
                    <responsiveStep minWidth="0" columns="1"/>
                    <responsiveStep minWidth="60em" columns="3"/>
                </responsiveSteps>
                <textField property="maDonThuoc" readOnly="true"/>
                <select id="loaiDonField" property="loaiDon"/>
                <select property="hinhThucDieuTri"/>
                <dateTimePicker id="ngayKeField" property="ngayKe"/>
                <datePicker property="ngayTaiKham"/>
                <textField property="tenBacSi" colspan="3"/>
                <textArea property="chanDoanText" colspan="3" height="6em"/>
                <textArea id="lyDoKhamField" property="lyDoKham" colspan="3" height="5em" label="Lưu ý"/>
                <textArea property="loiDan" colspan="3" height="6em"/>
            </formLayout>
        </vbox>

        <vbox id="thuocBox" width="100%" spacing="false" padding="true"
              css="border: 1px solid var(--lumo-contrast-20pct); border-radius: 8px; background: var(--lumo-base-color);">
            <hbox width="100%" alignItems="CENTER" justifyContent="BETWEEN"
                  css="margin-bottom: 8px; padding-bottom: 8px; border-bottom: 2px solid var(--lumo-primary-color);">
                <hbox spacing="true" alignItems="CENTER">
                    <icon icon="vaadin:pill" size="18px" color="var(--lumo-primary-color)"/>
                    <h4 text="DANH SÁCH THUỐC"
                        css="margin: 0; color: var(--lumo-primary-color); font-weight: bold;"/>
                    <span id="thuocCountLabel" themeName="badge"/>
                </hbox>
                <button id="addThuocButton" text="Thêm thuốc" icon="vaadin:plus" themeName="primary"/>
            </hbox>
            <dataGrid id="chiTietDataGrid" width="100%" minHeight="220px" dataContainer="chiTietsDc"
                      css="padding: 8px 0 0 0;">
                <emptyStateComponent>
                    <vbox width="100%" height="100%" alignItems="CENTER" justifyContent="CENTER">
                        <icon icon="vaadin:file-o" size="40px" color="var(--lumo-tertiary-text-color)"/>
                        <span text="Chưa có thuốc nào"/>
                    </vbox>
                </emptyStateComponent>
                <columns resizable="true">
                    <column property="stt" width="3em" header="STT"/>
                    <column property="tenThuocSnapshot" header="Thuốc"/>
                    <column property="maThuocSnapshot" header="Mã thuốc" width="8em"/>
                    <column property="donViTinhSnapshot" header="Đơn vị tính" width="7em"/>
                    <column property="soLuong" header="Số lượng" width="6em"/>
                    <column property="cachDung" header="Cách dùng"/>
                    <column key="actionsColumn" header="Thao tác" width="7em" flexGrow="0"/>
                </columns>
            </dataGrid>
        </vbox>

        <hbox id="actionsBox" justifyContent="END" spacing="true" width="100%">
            <button id="cancelDonBtn" text="Huỷ đơn" icon="vaadin:close"/>
            <button id="saveDraftBtn" text="Lưu nháp" icon="vaadin:edit"/>
            <button id="issueBtn" text="Lưu &amp; phát hành" icon="vaadin:check" themeName="primary"/>
            <button id="closeBtn" text="Đóng" icon="vaadin:close-circle"/>
        </hbox>
    </layout>
</view>