<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://donThuocQuickAddDialog.title"
      focusComponent="formHeader">
    <data>
        <instance id="donThuocDc" class="com.company.clinicportal.entity.DonThuoc">
            <fetchPlan extends="_base">
                <property name="chiTiets" fetchPlan="_base"/>
                <property name="chanDoans" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="donThuocDl"/>
            <collection id="chiTietsDc" property="chiTiets"/>
            <collection id="chanDoansDc" property="chanDoans"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout expand="actionsBox" spacing="false" padding="false">
        <vbox id="formHeader" width="100%" spacing="true" padding="true">
            <formLayout id="form" dataContainer="donThuocDc">
                <responsiveSteps>
                    <responsiveStep minWidth="0" columns="1"/>
                    <responsiveStep minWidth="60em" columns="3"/>
                </responsiveSteps>
                <textField property="maDonThuoc" readOnly="true"/>
                <select id="loaiDonField" property="loaiDon" label="Loại đơn"
                        optionsEnum="com.company.clinicportal.enumentity.LoaiDon" required="true"/>
                <select property="hinhThucDieuTri" label="Hình thức điều trị"
                        optionsEnum="com.company.clinicportal.enumentity.HinhThucDieuTri" required="true"/>
                <dateTimePicker id="ngayKeField" property="ngayKe" label="Ngày kê" required="true"/>
                <datePicker property="ngayTaiKham" required="true"/>
                <textField property="tenBacSi" colspan="3" required="true"/>
                <textArea property="chanDoanText" colspan="3" height="6em" required="true"/>
                <textArea id="lyDoKhamField" property="lyDoKham" colspan="3" height="5em" label="Lưu ý" required="true"/>
                <textArea property="loiDan" colspan="3" height="6em" required="true"/>
            </formLayout>
        </vbox>

        <vbox id="chanDoanBox" width="100%" spacing="false" padding="true"
              css="border: 1px solid var(--lumo-contrast-20pct); border-radius: 8px; background: var(--lumo-base-color);">
            <hbox width="100%" alignItems="CENTER" justifyContent="BETWEEN"
                  css="margin-bottom: 8px; padding-bottom: 8px; border-bottom: 2px solid var(--lumo-primary-color);">
                <hbox spacing="true" alignItems="CENTER">
                    <icon icon="vaadin:stethoscope" size="18px" color="var(--lumo-primary-color)"/>
                    <h4 text="CHẨN ĐOÁN ICD-10"
                        css="margin: 0; color: var(--lumo-primary-color); font-weight: bold;"/>
                    <span id="chanDoanCountLabel" themeName="badge"/>
                </hbox>
                <button id="addChanDoanButton" text="Thêm chẩn đoán" icon="vaadin:plus" themeName="primary"
                    action="chanDoanDataGrid.create"/>
            </hbox>
            <dataGrid id="chanDoanDataGrid" width="100%" minHeight="140px" dataContainer="chanDoansDc"
                      editorEnabled="true">
                <actions>
                    <action id="create" type="list_create" text="Thêm chẩn đoán"/>
                    <action id="edit" type="list_edit" text="Chi tiết"/>
                    <action id="remove" type="list_remove" text="Xóa"/>
                </actions>
                <emptyStateComponent>
                    <vbox width="100%" height="100%" alignItems="CENTER" justifyContent="CENTER">
                        <icon icon="vaadin:file-o" size="36px" color="var(--lumo-tertiary-text-color)"/>
                        <span text="Chưa có chẩn đoán"/>
                    </vbox>
                </emptyStateComponent>
                <columns resizable="true">
                    <column property="stt" width="3em" header="STT"/>
                    <column property="icd10" header="ICD-10" editable="true" width="10em">
                        <entityPicker/>
                    </column>
                    <column property="maIcdSnapshot" header="Mã ICD" editable="false" width="7em"/>
                    <column property="tenIcdSnapshot" header="Tên bệnh" editable="false"/>
                    <column property="ketLuan" header="Kết luận" editable="true">
                        <textField/>
                    </column>
                </columns>
            </dataGrid>
        </vbox>

        <vbox id="thuocBox" width="100%" spacing="false" padding="true"
              css="border: 1px solid var(--lumo-contrast-20pct); border-radius: 8px; background: var(--lumo-base-color);">
            <hbox width="100%" alignItems="CENTER" justifyContent="BETWEEN"
                  css="margin-bottom: 8px; padding-bottom: 8px; border-bottom: 2px solid var(--lumo-primary-color);">
                <hbox spacing="true" alignItems="CENTER">
                    <icon icon="vaadin:pill" size="18px" color="var(--lumo-primary-color)"/>
                    <h4 text="DANH SÁCH THUỐC"
                        css="margin: 0; color: var(--lumo-primary-color); font-weight: bold;"/>
                    <span id="thuocCountLabel" themeName="badge"/>
                </hbox>
                <button id="addThuocButton" text="Thêm thuốc" icon="vaadin:plus" themeName="primary"
                    action="chiTietDataGrid.create"/>
            </hbox>
            <dataGrid id="chiTietDataGrid" width="100%" minHeight="220px" dataContainer="chiTietsDc"
                      editorEnabled="true"
                      css="padding: 8px 0 0 0;">
                <actions>
                    <action id="create" type="list_create" text="Thêm thuốc"/>
                    <action id="edit" type="list_edit" text="Chi tiết"/>
                    <action id="remove" type="list_remove" text="Xóa"/>
                </actions>
                <emptyStateComponent>
                    <vbox width="100%" height="100%" alignItems="CENTER" justifyContent="CENTER">
                        <icon icon="vaadin:file-o" size="40px" color="var(--lumo-tertiary-text-color)"/>
                        <span text="Chưa có thuốc nào"/>
                    </vbox>
                </emptyStateComponent>
                <columns resizable="true">
                    <column property="stt" width="3em" header="STT"/>
                    <column property="tenThuocSnapshot" header="Thuốc"/>
                    <column property="maThuocSnapshot" header="Mã thuốc" width="8em"/>
                    <column property="donViTinhSnapshot" header="Đơn vị tính" width="7em"/>
                    <column property="soLuong" header="Số lượng" width="6em" editable="true">
                        <textField/>
                    </column>
                    <column property="cachDung" header="Cách dùng" editable="true">
                        <textField/>
                    </column>
                    <column key="actionsColumn" header="Thao tác" width="7em" flexGrow="0"/>
                </columns>
            </dataGrid>
        </vbox>

        <hbox id="actionsBox" justifyContent="END" spacing="true" width="100%">
            <button id="cancelDonBtn" text="Huỷ đơn" icon="vaadin:close"/>
            <button id="saveDraftBtn" text="Lưu nháp" icon="vaadin:edit"/>
            <button id="issueBtn" text="Lưu &amp; phát hành" icon="vaadin:check" themeName="primary"/>
            <button id="closeBtn" text="Đóng" icon="vaadin:close-circle"/>
        </hbox>
    </layout>
</view>