<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://donThuocChanDoanEditDialog.title">
    <data>
        <instance id="chanDoanDc" class="com.company.clinicportal.entity.DonThuocChanDoan">
            <fetchPlan extends="_base"/>
            <loader id="chanDoanDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <!-- KHÔNG bật dataLoadCoordinator auto="true" vì dialog mở qua
             .editEntity(cd) + .withContainer(chanDoansDc) +
             .withParentDataContext(...) — parent DataContext đã quản lý entity.
             Nếu bật auto, loader sẽ tự load entity từ DB theo id, ghi đè
             lên entity đã truyền vào → form bind sai instance, giá trị nhập
             vào sẽ KHÔNG được ghi vào entity trên grid cha (và còn có nguy cơ
             gây lỗi INSERT với id_don_thuoc=null do entity bị detach khỏi
             parent). Loader vẫn được khai báo để StandardDetailView có thể
             tìm thấy khi .editEntity(cd) được gọi. -->
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout expand="actionsBox" spacing="false" padding="false">
        <vbox width="100%" height="100%" spacing="true" padding="false">
            <vbox spacing="false" width="100%"
                  css="border: 1px solid var(--lumo-contrast-20pct); border-radius: 8px; padding: 16px; background: var(--lumo-base-color);">

                <hbox width="100%" alignItems="CENTER" justifyContent="BETWEEN"
                      css="margin-bottom: 12px; padding-bottom: 12px; border-bottom: 2px solid var(--lumo-primary-color);">
                    <hbox spacing="true" alignItems="CENTER">
                        <icon icon="vaadin:stethoscope" size="20px"
                              color="var(--lumo-primary-color)"/>
                        <h3 text="msg://donThuocChanDoanEditDialog.header"
                            css="margin: 0; color: var(--lumo-primary-color); font-weight: bold;"/>
                    </hbox>
                </hbox>

                <formLayout id="form" dataContainer="chanDoanDc" width="100%">
                    <responsiveSteps>
                        <responsiveStep minWidth="0" columns="1"/>
                        <responsiveStep minWidth="48em" columns="2"/>
                    </responsiveSteps>

                    <entityPicker id="icd10Field" property="icd10" colspan="2" width="100%"
                                  label="msg://donThuocChanDoanEditDialog.icdLabel">
                        <actions>
                            <action id="entityLookup" type="entity_lookup">
                                <properties>
                                    <property name="openMode" value="DIALOG"/>
                                    <property name="viewId" value="ltcs_Icd10.list"/>
                                </properties>
                            </action>
                            <action id="entityClear" type="entity_clear"/>
                        </actions>
                    </entityPicker>

                    <textField id="maIcdSnapshotField" property="maIcdSnapshot" readOnly="true"
                               label="msg://donThuocChanDoanEditDialog.codeLabel"/>
                    <textField id="tenIcdSnapshotField" property="tenIcdSnapshot" readOnly="true"
                               label="msg://donThuocChanDoanEditDialog.nameLabel"/>
                    <textArea id="ketLuanField" property="ketLuan" colspan="2" height="100px"
                              label="msg://donThuocChanDoanEditDialog.ketLuanLabel" required="true"/>
                </formLayout>

                <hbox id="actionsBox" justifyContent="END" spacing="true" width="100%"
                      css="margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--lumo-contrast-10pct);">
                    <button id="cancelBtn" action="closeAction" text="Hủy bỏ" icon="vaadin:close" themeName="tertiary"/>
                    <button id="saveBtn" action="saveAction" text="Lưu chẩn đoán" icon="vaadin:check" themeName="primary"/>
                </hbox>
            </vbox>
        </vbox>
    </layout>
</view>
