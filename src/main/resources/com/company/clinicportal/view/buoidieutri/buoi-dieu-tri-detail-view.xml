<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://buoiDieuTriDetailView.title"
      focusComponent="form">
    <data>
        <instance id="buoiDieuTriDc"
                  class="com.company.clinicportal.entity.BuoiDieuTri">
            <fetchPlan extends="_base">
                <property name="id"/>
                <property name="idNhanSuStaging" fetchPlan="_base"/>
                <property name="idNhanSu2Staging" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="buoiDieuTriDl"/>
        </instance>
        <collection id="nhanSusDc" class="com.company.clinicportal.entity.NhanSu">
            <loader id="nhanSusDl" readOnly="true">
                <query>
                    <![CDATA[select e from NhanSu e]]>
                </query>
            </loader>
            <fetchPlan extends="_base"/>
        </collection>

    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="buoiDieuTriDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <datePicker id="ngayThucHienField" property="ngayThucHien"/>
            <timePicker id="gioBatDauField" property="gioBatDau"/>
            <timePicker id="gioKetThucField" property="gioKetThuc" required="true"/>
            <entityComboBox id="idNhanSuStagingField" property="idNhanSuStaging" label="Nhân sự" itemsContainer="nhanSusDc" required="true"/>
            <entityComboBox id="idNhanSuStaging2Field" property="idNhanSu2Staging" label="Nhân sự thực hiện 2" itemsContainer="nhanSusDc"/>
            <select id="trangThaiField" property="trangThai" required="true"/>
        </formLayout>
        <hbox id="detailActions" justifyContent="END" alignItems="END" alignSelf="END">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
