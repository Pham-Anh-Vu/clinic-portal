<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"

      title="msg://buoiDieuTriListView.title"
      focusComponent="buoiDieuTrisDataGrid">
    <data>
        <collection id="buoiDieuTrisDc"
                    class="com.company.clinicportal.entity.BuoiDieuTri">
            <fetchPlan extends="_base">
                <property name="id"/>
            </fetchPlan>
            <loader id="buoiDieuTrisDl" readOnly="true">
                <query>
                    <![CDATA[select e from BuoiDieuTri e
                        where (:idChiTietDichVu is null or e.idChiTietDichVu.id = :idChiTietDichVu)
                    ]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="buoiDieuTrisDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createButton" action="buoiDieuTrisDataGrid.createAction"/>
            <button id="editButton" action="buoiDieuTrisDataGrid.editAction"/>
            <button id="removeButton" action="buoiDieuTrisDataGrid.removeAction"/>
            <simplePagination id="pagination" dataLoader="buoiDieuTrisDl"/>
        </hbox>
        <dataGrid id="buoiDieuTrisDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="buoiDieuTrisDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="ca"/>
                <column property="createdAt"/>
                <column property="createdById"/>
                <column property="fS6gkc3y0vfj"/>
                <column property="gioBatDau"/>
                <column property="gioBatDauStaging"/>
                <column property="gioKetThuc"/>
                <column property="idBenhNhan"/>
                <column property="idChiTietDichVu"/>
                <column property="idNgayDieuTri"/>
                <column property="idNhanSu2"/>
                <column property="idNhanSu2Staging"/>
                <column property="idNhanSuStaging"/>
                <column property="ngayThucHien"/>
                <column property="ngayThucHienStaging"/>
                <column property="trangThai"/>
                <column property="updatedAt"/>
                <column property="updatedById"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
