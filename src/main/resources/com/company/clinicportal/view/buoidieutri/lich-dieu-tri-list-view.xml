<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://lichDieuTriListView.title"
      focusComponent="buoiDieuTrisDataGrid">
    <data>
        <collection id="buoiDieuTrisDc"
                    class="com.company.clinicportal.entity.BuoiDieuTri">
            <fetchPlan extends="_base">
                <property name="idBenhNhan" fetchPlan="_base">
                    <property name="hoVaTen"/>
                </property>
                <property name="idChiTietDichVu" fetchPlan="_base">
                    <property name="idChiTietPhieuDieuTri" fetchPlan="_base">
                        <property name="chuanDoan"/>
                    </property>
                </property>
            </fetchPlan>
            <loader id="buoiDieuTrisDl" readOnly="true">
                <query>
                    <![CDATA[select e from BuoiDieuTri e where e.ngayThucHien = :currentDate order by e.createdAt desc]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="buoiDieuTrisDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="refreshButton" action="buoiDieuTrisDataGrid.refreshAction"/>
            <simplePagination id="pagination" dataLoader="buoiDieuTrisDl"/>
        </hbox>
        <dataGrid id="buoiDieuTrisDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="buoiDieuTrisDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="refreshAction" type="list_refresh"/>
            </actions>
            <columns resizable="true">
                <column property="idBenhNhan.hoVaTen"/>
                <column property="idBenhNhan.ngaySinh"/>
                <column property="idBenhNhan.diaChi"/>
                <column key="ca" header="ca"/>
                <column property="idChiTietDichVu.idChiTietPhieuDieuTri.chuanDoan"/>
                <column property="idChiTietDichVu.idChiTietPhieuDieuTri.createdAt"/>
                <column property="ngayThucHien"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
